                            Rectangle { height: 28px; border-radius: 5px; background: #181f2e; border-width: 1px; border-color: #343858; dl-edit := LineEdit { text <=> cfg-dl-dir; } }
                        }
                        HorizontalLayout { spacing: 8px;
