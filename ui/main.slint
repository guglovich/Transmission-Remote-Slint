                                sched-ta := TouchArea { clicked => { cfg-alt-speed-schedule = !cfg-alt-speed-schedule; } }
                                Rectangle { width: 16px; height: 16px; border-radius: 8px; background: #dce4f5; x: cfg-alt-speed-schedule ? parent.width - self.width - 2px : 2px; y: (parent.height - self.height) / 2; animate x { duration: 150ms; } }
                            }
