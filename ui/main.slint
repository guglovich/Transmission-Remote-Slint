                                    Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; spls := TouchArea { clicked => { cfg-dl-seed-ratio-limit-min = Math.min(999, cfg-dl-seed-ratio-limit-min + 5); } } Text { text: "+"; color: #8f97b8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
