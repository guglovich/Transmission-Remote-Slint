                                    Rectangle { height: 28px; border-radius: 5px; background: #181f2e; border-width: 1px; border-color: #343858;
                                        HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 4px; alignment: center;
                                            Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; fmin := TouchArea { clicked => { cfg-alt-speed-time-begin = Math.max(0, cfg-alt-speed-time-begin - 30); } } Text { text: "−"; color: #8f97b8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                            Text { text: (cfg-alt-speed-time-begin / 60) + ":" + (Math.mod(cfg-alt-speed-time-begin, 60) == 0 ? "00" : "30"); color: #dce4f5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                                            Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; fpls := TouchArea { clicked => { cfg-alt-speed-time-begin = Math.min(1410, cfg-alt-speed-time-begin + 30); } } Text { text: "+"; color: #8f97b8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
                                        }
                                    }
