                                Rectangle { width: 16px; height: 16px; border-radius: 8px; background: #dce4f5; x: cfg-seed-ratio-enabled ? parent.width - self.width - 2px : 2px; y: (parent.height - self.height) / 2; animate x { duration: 150ms; } }
