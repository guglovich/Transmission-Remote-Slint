                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-fri ? #4a7cf7 : #13151c; border-color: cfg-speed-day-fri ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-fri = !cfg-speed-day-fri; } } Text { text: "Fri"; color: cfg-speed-day-fri ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-sat ? #4a7cf7 : #13151c; border-color: cfg-speed-day-sat ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-sat = !cfg-speed-day-sat; } } Text { text: "Sat"; color: cfg-speed-day-sat ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-sun ? #4a7cf7 : #13151c; border-color: cfg-speed-day-sun ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-sun = !cfg-speed-day-sun; } } Text { text: "Sun"; color: cfg-speed-day-sun ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                    }
                    if settings-tab == 2: VerticalLayout { padding: 20px; spacing: 10px; alignment: start;
                        Text { text: "DOWNLOADING"; color: #8f97b8; font-size: 11px; font-weight: 600; }
                        VerticalLayout { spacing: 4px;
