                            HorizontalLayout { spacing: 4px;
                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-mon ? #4a7cf7 : #13151c; border-color: cfg-speed-day-mon ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-mon = !cfg-speed-day-mon; } } Text { text: "Mon"; color: cfg-speed-day-mon ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-tue ? #4a7cf7 : #13151c; border-color: cfg-speed-day-tue ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-tue = !cfg-speed-day-tue; } } Text { text: "Tue"; color: cfg-speed-day-tue ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                                Rectangle { width: 36px; height: 28px; border-radius: 14px; border-width: 1px; background: cfg-speed-day-wed ? #4a7cf7 : #13151c; border-color: cfg-speed-day-wed ? #4a7cf7 : #252840; TouchArea { clicked => { cfg-speed-day-wed = !cfg-speed-day-wed; } } Text { text: "Wed"; color: cfg-speed-day-wed ? #e4e7f2 : #8f97b8; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
