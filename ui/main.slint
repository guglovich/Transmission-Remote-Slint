import { Button, ScrollView, ProgressIndicator, LineEdit, ListView } from "std-widgets.slint";

// ── Data model ────────────────────────────────────────────────────────────────

export struct TorrentItem {
    id: int,
    name: string,
    status-label: string,
    progress: float,
    down-speed: string,
    up-speed: string,
    is-paused: bool,
    is-error: bool,
    is-checking: bool,
    download-dir: string,
    error-string: string,
}

export struct SessionStats {
    down-speed: string,
    up-speed: string,
    downloaded: string,
    uploaded: string,
    ratio: string,
    active: int,
    dht: int,
    peers: int,
}

export struct DiskItem {
    label: string,
    kind: string,       // "disk", "raid", "lvm", "btrfs"
    mountpoints: string, // через ", "
    torrent-count: int,
}

// ── Confirm dialog ────────────────────────────────────────────────────────────

component ConfirmDialog inherits Rectangle {
    in property <string> message;
    in property <string> torrent-name;
    in property <bool>   show-warning;
    in property <bool>   visible-dialog;
    in property <string> tr-cancel;
    in property <string> tr-confirm;
    in property <string> tr-delete-warning;
    in property <string> tr-irreversible;
    callback confirmed();
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    Rectangle {
        width: 480px; height: show-warning ? 240px : 180px;
        background: #1e2430;
        border-radius: 10px;
        border-width: 1px; border-color: #3a4560;

        VerticalLayout {
            padding: 24px; spacing: 16px;
            
            // Torrent name
            if torrent-name != "": Text {
                text: "🗂 " + torrent-name;
                color: #70a8d8; font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            
            // Main message
            Text {
                text: message; color: #dce4f5; font-size: 14px;
                wrap: word-wrap; horizontal-alignment: center;
            }
            
            // Warning for file deletion
            if show-warning: VerticalLayout {
                spacing: 6px;
                Text {
                    text: tr-delete-warning;
                    color: #e08080; font-size: 12px;
                    horizontal-alignment: center;
                }
                Text {
                    text: tr-irreversible;
                    color: #a06060; font-size: 11px;
                    horizontal-alignment: center;
                }
            }
            
            HorizontalLayout {
                spacing: 14px; alignment: center;
                Button { text: tr-cancel;  clicked => { cancelled(); } }
                Button { text: tr-confirm; clicked => { confirmed(); } }
            }
        }
    }
}

// ── Close dialog: свернуть в трей или закрыть ─────────────────────────────────

component CloseDialog inherits Rectangle {
    in property <bool> visible-dialog;
    callback minimize-to-tray();
    callback quit-app();
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    Rectangle {
        width: 380px; height: 190px;
        background: #1e2430;
        border-radius: 10px;
        border-width: 1px; border-color: #3a4560;

        VerticalLayout {
            padding: 28px; spacing: 18px;

            Text {
                text: "What would you like to do?";
                color: #dce4f5; font-size: 14px;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px; alignment: center;
                Button {
                    text: "⬇ Minimize to tray";
                    clicked => { minimize-to-tray(); }
                }
                Button {
                    text: "✕ Quit";
                    clicked => { quit-app(); }
                }
            }

            HorizontalLayout {
                alignment: center;
                Button {
                    text: "Cancel";
                    clicked => { cancelled(); }
                }
            }
        }
    }
}

// ── Add torrent dialog ────────────────────────────────────────────────────────

component AddTorrentDialog inherits Rectangle {
    in property <bool> visible-dialog;
    callback submitted-url(string);
    callback pick-file();
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    property <string> input-text: "";

    Rectangle {
        width: 540px; height: 200px;
        background: #1e2430;
        border-radius: 10px;
        border-width: 1px; border-color: #3a4560;

        VerticalLayout {
            padding: 24px; spacing: 14px;
            Text {
                text: "Add torrent";
                color: #dce4f5; font-size: 15px; font-weight: 600;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "magnet:?xt=urn:btih:…  or  https://…";
                    text <=> input-text;
                    accepted(t) => {
                        if (t != "") { submitted-url(t); input-text = ""; }
                    }
                }
                Button {
                    text: "Add URL";
                    clicked => {
                        if (input-text != "") { submitted-url(input-text); input-text = ""; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button { text: "📂 Browse .torrent…"; clicked => { pick-file(); } }
                Button { text: "Cancel"; clicked => { input-text = ""; cancelled(); } }
            }
        }
    }
}

// ── Create torrent dialog ─────────────────────────────────────────────────────

component CreateTorrentDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in-out property <string> path-text: "";
    callback submitted(string, string);
    callback pick-path();
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    property <string> trackers-text: "";

    Rectangle {
        width: 580px; height: 260px;
        background: #1e2430;
        border-radius: 10px;
        border-width: 1px; border-color: #3a4560;

        VerticalLayout {
            padding: 24px; spacing: 14px;

            Text {
                text: "Create torrent";
                color: #dce4f5; font-size: 15px; font-weight: 600;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "/path/to/folder or file";
                    text <=> path-text;
                }
                Button { text: "📂 Browse…"; clicked => { pick-path(); } }
            }

            LineEdit {
                placeholder-text: "Trackers (one URL per line, optional)";
                text <=> trackers-text;
            }

            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button {
                    text: "✚ Create";
                    clicked => {
                        if (path-text != "") {
                            submitted(path-text, trackers-text);
                            path-text = ""; trackers-text = "";
                        }
                    }
                }
                Button {
                    text: "Cancel";
                    clicked => { path-text = ""; trackers-text = ""; cancelled(); }
                }
            }
        }
    }
}

// ── Magnet dialog ─────────────────────────────────────────────────────────────

// ── Set Location Dialog ───────────────────────────────────────────────────────

component SetLocationDialog inherits Rectangle {
    in property <bool>   visible-dialog;
    in property <string> torrent-name;
    in-out property <string> path: "";
    in-out property <bool>   do-move: true;
    callback pick-folder();          // открыть XDG выбор папки
    callback confirmed(string, bool); // path, do-move
    callback cancelled();

    visible: visible-dialog;
    z: 200;
    background: #00000099;

    Rectangle {
        width: 520px; height: 230px;
        x: (parent.width  - self.width)  / 2;
        y: (parent.height - self.height) / 2;
        background: #1e2430;
        border-radius: 12px;
        border-width: 1px; border-color: #3a4560;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000088;

        VerticalLayout {
            padding: 22px; spacing: 16px;

            // ── Header ──────────────────────────────────────────────────────
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "📍 Указать расположение";
                    color: #dce4f5; font-size: 15px; font-weight: 700;
                    horizontal-alignment: center;
                }
                if torrent-name != "": Text {
                    text: torrent-name;
                    color: #6a8ab8; font-size: 12px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            // ── Path input row ───────────────────────────────────────────────
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "/home/user/Downloads";
                    text <=> path;
                }
                Rectangle {
                    width: 36px; height: 36px;
                    background: folder-btn.has-hover ? #2e4a70 : #253450;
                    border-radius: 7px;
                    border-width: 1px; border-color: #3a5070;
                    Text {
                        text: "📁";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    folder-btn := TouchArea {
                        clicked => { pick-folder(); }
                    }
                }
            }

            // ── Toggle: переместить файлы ────────────────────────────────────
            HorizontalLayout {
                spacing: 10px; alignment: start;
                // Toggle track
                Rectangle {
                    width: 40px; height: 22px;
                    border-radius: 11px;
                    background: do-move ? #4a7cf7 : #2a3448;
                    animate background { duration: 150ms; }
                    // Thumb
                    Rectangle {
                        width: 16px; height: 16px;
                        border-radius: 8px;
                        background: #ffffff;
                        x: do-move ? 21px : 3px;
                        y: 3px;
                        animate x { duration: 150ms; }
                    }
                    TouchArea { clicked => { do-move = !do-move; } }
                }
                Text {
                    text: do-move ? "Переместить файлы" : "Только обновить путь";
                    color: #c0d0e8; font-size: 13px;
                    vertical-alignment: center;
                }
            }

            // ── Buttons ──────────────────────────────────────────────────────
            HorizontalLayout {
                spacing: 10px; alignment: center;
                Button {
                    text: "Отмена";
                    clicked => { cancelled(); }
                }
                Button {
                    text: do-move ? "Переместить" : "Применить";
                    primary: true;
                    clicked => {
                        if (path != "") { confirmed(path, do-move); }
                    }
                }
            }
        }
    }
}

component MagnetDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in-out property <string> magnet-uri: "";
    callback submitted(string);
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    Rectangle {
        width: 500px; height: 180px;
        background: #1e2430;
        border-radius: 10px;
        border-width: 1px; border-color: #3a4560;

        VerticalLayout {
            padding: 24px; spacing: 14px;

            Text {
                text: "Add Magnet Link";
                color: #dce4f5; font-size: 15px; font-weight: 600;
                horizontal-alignment: center;
            }

            LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "magnet:?xt=urn:btih:...";
                text <=> magnet-uri;
            }

            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button {
                    text: "OK";
                    clicked => {
                        if (magnet-uri != "") {
                            submitted(magnet-uri);
                            magnet-uri = "";
                        }
                    }
                }
                Button {
                    text: "Cancel";
                    clicked => { magnet-uri = ""; cancelled(); }
                }
            }
        }
    }
}

// ── Settings dialog ───────────────────────────────────────────────────────────

component SettingsDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in-out property <string> selected-language: "en";
    in-out property <int> settings-tab: 0;
    callback language-changed(string);
    callback saved();
    callback cancelled();
    in-out property <bool> cfg-speed-up-enabled: false;
    in-out property <int> cfg-speed-up-kbs: 0;
    in-out property <bool> cfg-speed-down-enabled: false;
    in-out property <int> cfg-speed-down-kbs: 0;
    in-out property <bool> cfg-alt-speed-enabled: false;
    in-out property <int> cfg-alt-speed-up-kbs: 0;
    in-out property <int> cfg-alt-speed-down-kbs: 0;
    in-out property <bool> cfg-alt-speed-schedule: false;
    in-out property <int> cfg-alt-speed-time-begin: 540;
    in-out property <int> cfg-alt-speed-time-end: 1020;
    in-out property <bool> cfg-speed-day-mon: true;
    in-out property <bool> cfg-speed-day-tue: true;
    in-out property <bool> cfg-speed-day-wed: true;
    in-out property <bool> cfg-speed-day-thu: true;
    in-out property <bool> cfg-speed-day-fri: true;
    in-out property <bool> cfg-speed-day-sat: false;
    in-out property <bool> cfg-speed-day-sun: false;
    in-out property <bool> cfg-dl-watch-dir-enabled: false;
    in-out property <string> cfg-dl-watch-dir: "";
    in-out property <bool> cfg-dl-start-added: true;
    in-out property <bool> cfg-dl-trash-torrent: false;
    in-out property <string> cfg-dl-dir: "";
    in-out property <int> cfg-dl-queue-max: 5;
    in-out property <int> cfg-dl-seed-ratio-limit-min: 30;
    in-out property <bool> cfg-dl-part-ext: true;
    in-out property <bool> cfg-dl-incomplete-dir-enabled: false;
    in-out property <string> cfg-dl-incomplete-dir: "";
    in-out property <bool> cfg-dl-done-script-enabled: false;
    in-out property <string> cfg-dl-done-script: "";
    in-out property <bool> cfg-seed-ratio-enabled: false;
    in-out property <int> cfg-seed-ratio: 200;
    in-out property <bool> cfg-seed-idle-enabled: false;
    in-out property <int> cfg-seed-idle-min: 30;
    in-out property <int> cfg-net-port: 51413;
    in-out property <bool> cfg-net-random-port: true;
    in-out property <bool> cfg-net-port-forward: true;
    in-out property <int> cfg-net-max-peers-torrent: 50;
    in-out property <int> cfg-net-max-peers-total: 200;
    in-out property <bool> cfg-net-utp: true;
    in-out property <bool> cfg-net-pex: true;
    in-out property <bool> cfg-net-dht: true;
    in-out property <bool> cfg-net-lpd: true;
    in-out property <string> cfg-net-default-trackers: "";
    in-out property <int> cfg-priv-encryption: 1;
    in-out property <bool> cfg-priv-blocklist-enabled: false;
    in-out property <string> cfg-priv-blocklist-url: "";
    in-out property <bool> cfg-remote-enabled: true;
    in-out property <int> cfg-remote-port: 9091;
    in-out property <bool> cfg-remote-auth: false;
    in-out property <string> cfg-remote-username: "";
    in-out property <string> cfg-remote-password: "";
    in-out property <bool> cfg-remote-whitelist-enabled: true;
    in-out property <string> cfg-remote-whitelist: "";
    in-out property <bool> cfg-autostart: false;
    in-out property <bool> cfg-suspend: false;
    in-out property <bool> cfg-start-minimized: false;
    in-out property <bool> cfg-delete-torrent: false;
    in-out property <int> cfg-refresh-interval: 5;
    in-out property <int> cfg-on-close: 0;
    in-out property <bool> cfg-notify-add: true;
    in-out property <bool> cfg-notify-complete: true;
    in-out property <bool> cfg-notify-sound: true;
    in-out property <int> cfg-theme: 0;
    in-out property <bool> cfg-tb-add: true;
    in-out property <bool> cfg-tb-magnet: true;
    in-out property <bool> cfg-tb-create: true;
    in-out property <bool> cfg-tb-rehash: true;
    in-out property <bool> cfg-tb-start-sel: true;
    in-out property <bool> cfg-tb-pause-sel: true;
    in-out property <bool> cfg-tb-start-all: true;
    in-out property <bool> cfg-tb-pause-all: true;
    in-out property <bool> cfg-lp-status: true;
    in-out property <bool> cfg-lp-disks: true;
    in-out property <bool> cfg-lp-trackers: false;
    in-out property <bool> cfg-lp-webtorrents: false;
    in-out property <bool> cfg-lp-tags: false;
    in-out property <bool> cfg-lp-created: false;
    property <int> priv-encryption-expanded: -1;
    visible: visible-dialog;
    z: 100;
    background: #00000099;
    Rectangle {
        width: 800px; height: 600px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #13151c; border-radius: 12px;
        border-width: 1px; border-color: #252840;
        drop-shadow-blur: 24px; drop-shadow-color: #00000088;
        VerticalLayout { padding: 0px; spacing: 0px;
            HorizontalLayout { height: 44px; padding-left: 20px;
                Text { text: "Settings"; color: #e4e7f2; font-size: 15px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Rectangle { height: 1px; background: #252840; }
            HorizontalLayout { vertical-stretch: 1; spacing: 0px;
                Rectangle { width: 160px; background: #13151c;
                    VerticalLayout { width: 160px; spacing: 2px; padding: 8px; alignment: start;
                    for tab-info in [
                        {ico: "⚙", n: 0, label: "General"},
                        {ico: "◎", n: 1, label: "Speed"},
                        {ico: "▾", n: 2, label: "Downloading"},
                        {ico: "▴", n: 3, label: "Seeding"},
                        {ico: "🌐", n: 4, label: "Network"},
                        {ico: "🛡", n: 5, label: "Privacy"},
                        {ico: "💻", n: 6, label: "Remote"},
                        {ico: "☰", n: 7, label: "Interface"},
                        {ico: "ⓘ", n: 8, label: "About"},
                    ]: Rectangle {
                        height: 34px; border-radius: 6px;
                        background: settings-tab == tab-info.n ? #21253a : transparent;
                        animate background { duration: 80ms; }
                        tab-ta := TouchArea { clicked => { settings-tab = tab-info.n; } }
                        HorizontalLayout { spacing: 10px; padding-left: 14px; alignment: center;
                            Rectangle { width: 3px; height: 18px; border-radius: 2px; background: settings-tab == tab-info.n ? #4a7cf7 : transparent; animate background { duration: 80ms; } }
                            Text { text: tab-info.ico; color: settings-tab == tab-info.n ? #4a7cf7 : #4e556e; font-size: 13px; }
                            Text { text: tab-info.label; color: settings-tab == tab-info.n ? #e4e7f2 : #8f97b8; font-size: 12px; }
                        }
                    }
                    }
                }
                Rectangle { width: 1px; background: #343858; }
                Rectangle { vertical-stretch: 1; background: #1a1d27;
                    if settings-tab == 0: VerticalLayout { padding: 20px; spacing: 12px; alignment: start;
                        Text { text: "Language / Язык интерфейса"; color: #dce4f5; font-size: 15px; font-weight: 700; }
                        Text { text: "⚠ Requires restart"; color: #c08030; font-size: 11px; }
                        for lang-item in [
                            {code: "en", label: "English"},
                            {code: "de", label: "Deutsch"},
                            {code: "ru", label: "Русский"},
                            {code: "zh", label: "中文"},
                            {code: "es", label: "Español"},
                        ]: Rectangle {
                            height: 34px; border-radius: 6px; border-width: 1px;
                            background: selected-language == lang-item.code ? #1e3a5a : (lang-ta.has-hover ? #232d40 : #181f2e);
                            border-color: selected-language == lang-item.code ? #4a8aba : transparent;
                            animate background { duration: 120ms; }
                            HorizontalLayout { padding-left: 12px; spacing: 0px;
                                Text { text: lang-item.label; color: selected-language == lang-item.code ? #a8d4f8 : #8090b0; font-size: 13px; vertical-alignment: center; animate color { duration: 120ms; } }
                                Rectangle { horizontal-stretch: 1; }
                                if selected-language == lang-item.code: Text { text: "✓"; color: #4a8aba; font-size: 13px; vertical-alignment: center; }
                            }
                            lang-ta := TouchArea { clicked => { selected-language = lang-item.code; language-changed(lang-item.code); } }
                        }
                    }
                    if settings-tab == 1: VerticalLayout { padding: 20px; spacing: 10px; alignment: start;
                        Text { text: "SPEED LIMITS"; color: #8f97b8; font-size: 11px; font-weight: 600; }
                        VerticalLayout { spacing: 4px;
                            Text { text: "Upload limit (KB/s)"; color: #8090b0; font-size: 11px; }
                            HorizontalLayout { spacing: 8px;
                                Rectangle { width: 36px; height: 20px; border-radius: 10px; background: cfg-speed-up-enabled ? #4a7cf7 : #2a3448; animate background { duration: 150ms; }
                                    up-ta := TouchArea { clicked => { cfg-speed-up-enabled = !cfg-speed-up-enabled; } }
                                    Rectangle { width: 16px; height: 16px; border-radius: 8px; background: #dce4f5; x: cfg-speed-up-enabled ? parent.width - self.width - 2px : 2px; y: (parent.height - self.height) / 2; animate x { duration: 150ms; } }
                                }
                                Rectangle { horizontal-stretch: 1; height: 28px; border-radius: 5px; background: #181f2e; border-width: 1px; border-color: #343858;
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                        Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; up-min := TouchArea { clicked => { cfg-speed-up-kbs = Math.max(0, cfg-speed-up-kbs - 1); } } Text { text: "−"; color: #8f97b8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                                        Text { text: cfg-speed-up-kbs * 100 + ""; color: #dce4f5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                                        Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; up-pls := TouchArea { clicked => { cfg-speed-up-kbs = Math.min(9999, cfg-speed-up-kbs + 1); } } Text { text: "+"; color: #8f97b8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                                    }
                                }
                            }
                        }
                        VerticalLayout { spacing: 4px;
                            Text { text: "Download limit (KB/s)"; color: #8090b0; font-size: 11px; }
                            HorizontalLayout { spacing: 8px;
                                Rectangle { width: 36px; height: 20px; border-radius: 10px; background: cfg-speed-down-enabled ? #4a7cf7 : #2a3448; animate background { duration: 150ms; }
                                    dn-ta := TouchArea { clicked => { cfg-speed-down-enabled = !cfg-speed-down-enabled; } }
                                    Rectangle { width: 16px; height: 16px; border-radius: 8px; background: #dce4f5; x: cfg-speed-down-enabled ? parent.width - self.width - 2px : 2px; y: (parent.height - self.height) / 2; animate x { duration: 150ms; } }
                                }
                                Rectangle { horizontal-stretch: 1; height: 28px; border-radius: 5px; background: #181f2e; border-width: 1px; border-color: #343858;
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                                        Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; dn-min := TouchArea { clicked => { cfg-speed-down-kbs = Math.max(0, cfg-speed-down-kbs - 1); } } Text { text: "−"; color: #8f97b8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                                        Text { text: cfg-speed-down-kbs * 100 + ""; color: #dce4f5; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                                        Rectangle { width: 20px; height: 20px; border-radius: 4px; background: #21253a; dn-pls := TouchArea { clicked => { cfg-speed-down-kbs = Math.min(9999, cfg-speed-down-kbs + 1); } } Text { text: "+"; color: #8f97b8; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #343858; }
                        Text { text: "ALT SPEEDS"; color: #e8a240; font-size: 11px; font-weight: 600; }
                        HorizontalLayout { spacing: 8px;
                            Rectangle { horizontal-stretch: 1; height: 28px; border-radius: 5px; background: #181f2e; border-width: 1px; border-color: #343858;
                                HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
