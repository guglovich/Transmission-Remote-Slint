    in-out property <bool>   cfg-net-lpd: true;
    in-out property <string> cfg-net-default-trackers: "";
    in-out property <int>     cfg-priv-encryption: 1;
    in-out property <bool>   cfg-priv-blocklist-enabled: false;
    in-out property <string> cfg-priv-blocklist-url: "";
    in-out property <bool>   cfg-priv-blocklist-auto-update: false;
    in-out property <int>    cfg-priv-blocklist-entries: 0;
    in-out property <bool>   cfg-remote-enabled: true;
    in-out property <int>     cfg-remote-port: 9091;
    in-out property <bool>   cfg-remote-auth: false;
    in-out property <string> cfg-remote-username: "";
    in-out property <string> cfg-remote-password: "";
