    name: string,
    status-label: string,
    progress: float,
    down-speed: string,
    up-speed: string,
    is-paused: bool,
    is-error: bool,
    is-checking: bool,
    download-dir: string,
    error-string: string,
}

export struct SessionStats {
    down-speed: string,
    up-speed: string,
    downloaded: string,
    uploaded: string,
    ratio: string,
    active: int,
    dht: int,
    peers: int,
}

export struct DiskItem {
    label: string,
    kind: string,       // "disk", "raid", "lvm", "btrfs"
    mountpoints: string,
    torrent-count: int,
}

