import { ComboBox, Button, ScrollView, ProgressIndicator, LineEdit, ListView } from "std-widgets.slint";

export struct TorrentItem {
    id: int,
    name: string,
    status-label: string,
    progress: float,
    down-speed: string,
    up-speed: string,
    is-paused: bool,
    is-error: bool,
    is-checking: bool,
    download-dir: string,
    error-string: string,
}

export struct SessionStats {
    down-speed: string,
    up-speed: string,
    downloaded: string,
    uploaded: string,
    ratio: string,
    active: int,
    dht: int,
    peers: int,
}

export struct DiskItem {
    label: string,
    kind: string,       // "disk", "raid", "lvm", "btrfs"
    mountpoints: string,
    torrent-count: int,
}

component ConfirmDialog inherits Rectangle {
    in property <string> message;
    in property <string> torrent-name;
    in property <bool>   show-warning;
    in property <bool>   visible-dialog;
    in property <string> tr-cancel;
    in property <string> tr-confirm;
    in property <string> tr-delete-warning;
    in property <string> tr-irreversible;
    callback confirmed();
    callback cancelled();

    visible: visible-dialog;
    z: 100;
    background: #00000099;

    Rectangle {
        width: 460px; height: show-warning ? 240px : 180px;
        background: #1e2430; border-radius: 10px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 24px; spacing: 16px;
            if torrent-name != "": Text {
                text: "🗂 " + torrent-name; color: #70a8d8; font-size: 13px;
                horizontal-alignment: center; wrap: word-wrap;
            }
            Text {
                text: message; color: #dce4f5; font-size: 14px;
                wrap: word-wrap; horizontal-alignment: center;
            }
            if show-warning: VerticalLayout {
                spacing: 6px;
                Text { text: tr-delete-warning; color: #e08080; font-size: 12px; horizontal-alignment: center; }
                Text { text: tr-irreversible; color: #a06060; font-size: 11px; horizontal-alignment: center; }
            }
            HorizontalLayout {
                spacing: 14px; alignment: center;
                Button { text: tr-cancel; clicked => { cancelled(); } }
                Button { text: tr-confirm; clicked => { confirmed(); } }
            }
        }
    }
}

component CloseDialog inherits Rectangle {
    in property <bool> visible-dialog;
    callback minimize-to-tray();
    callback quit-app();
    callback cancelled();

    visible: visible-dialog; z: 100;
    background: #00000099;

    Rectangle {
        width: 380px; height: 190px;
        background: #1e2430; border-radius: 10px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 28px; spacing: 18px;
            Text { text: "What would you like to do?"; color: #dce4f5; font-size: 14px; horizontal-alignment: center; }
            HorizontalLayout {
                spacing: 10px; alignment: center;
                Button { text: "⬇ Minimize to tray"; clicked => { minimize-to-tray(); } }
                Button { text: "✕ Quit"; clicked => { quit-app(); } }
            }
            HorizontalLayout {
                alignment: center;
                Button { text: "Cancel"; clicked => { cancelled(); } }
            }
        }
    }
}

component AddTorrentDialog inherits Rectangle {
    in property <bool> visible-dialog;
    callback submitted-url(string);
    callback pick-file();
    callback cancelled();

    visible: visible-dialog; z: 100;
    background: #00000099;
    property <string> input-text: "";

    Rectangle {
        width: 540px; height: 200px;
        background: #1e2430; border-radius: 10px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 24px; spacing: 14px;
            Text { text: "Add torrent"; color: #dce4f5; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1; placeholder-text: "magnet:?xt=urn:btih:…  or  https://…"; text <=> input-text;
                    accepted(t) => { if (t != "") { submitted-url(t); input-text = ""; } }
                }
                Button {
                    text: "Add URL";
                    clicked => { if (input-text != "") { submitted-url(input-text); input-text = ""; } }
                }
            }
            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button { text: "📂 Browse .torrent…"; clicked => { pick-file(); } }
                Button { text: "Cancel"; clicked => { input-text = ""; cancelled(); } }
            }
        }
    }
}

component CreateTorrentDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in-out property <string> path-text: "";
    callback submitted(string, string);
    callback pick-path();
    callback cancelled();

    visible: visible-dialog; z: 100;
    background: #00000099;
    property <string> trackers-text: "";

    Rectangle {
        width: 580px; height: 260px;
        background: #1e2430; border-radius: 10px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 24px; spacing: 14px;
            Text { text: "Create torrent"; color: #dce4f5; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { horizontal-stretch: 1; placeholder-text: "/path/to/folder or file"; text <=> path-text; }
                Button { text: "📂 Browse…"; clicked => { pick-path(); } }
            }
            LineEdit { placeholder-text: "Trackers (one URL per line, optional)"; text <=> trackers-text; }
            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button { text: "✚ Create"; clicked => { if (path-text != "") { submitted(path-text, trackers-text); path-text = ""; trackers-text = ""; } } }
                Button { text: "Cancel"; clicked => { path-text = ""; trackers-text = ""; cancelled(); } }
            }
        }
    }
}

component SetLocationDialog inherits Rectangle {
    in property <bool>   visible-dialog;
    in property <string> torrent-name;
    in-out property <string> path: "";
    in-out property <bool>   do-move: true;
    callback pick-folder();
    callback confirmed(string, bool);
    callback cancelled();

    visible: visible-dialog; z: 200;
    background: #00000099;

    Rectangle {
        width: 520px; height: 230px;
        background: #1e2430; border-radius: 12px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 22px; spacing: 16px;
            VerticalLayout {
                spacing: 4px;
                Text { text: "📍 Указать расположение"; color: #dce4f5; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
                if torrent-name != "": Text { text: torrent-name; color: #6a8ab8; font-size: 12px; horizontal-alignment: center; overflow: elide; }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { horizontal-stretch: 1; placeholder-text: "/home/user/Downloads"; text <=> path; }
                Rectangle {
                    width: 36px; height: 36px; background: folder-btn.has-hover ? #2e4a70 : #253450;
                    border-radius: 7px; border-width: 1px; border-color: #3a5070;
                    Text { text: "📁"; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                    folder-btn := TouchArea { clicked => { pick-folder(); } }
                }
            }
            HorizontalLayout {
                spacing: 10px; alignment: start;
                Rectangle {
                    width: 40px; height: 22px; border-radius: 11px;
                    background: do-move ? #4a7cf7 : #2a3448;
                    Rectangle { width: 16px; height: 16px; border-radius: 8px; background: #ffffff; x: do-move ? 21px : 3px; y: 3px; }
                    TouchArea { clicked => { do-move = !do-move; } }
                }
                Text { text: do-move ? "Переместить файлы" : "Только обновить путь"; color: #c0d0e8; font-size: 13px; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 10px; alignment: center;
                Button { text: "Отмена"; clicked => { cancelled(); } }
                Button { text: do-move ? "Переместить" : "Применить"; clicked => { if (path != "") { confirmed(path, do-move); } } }
            }
        }
    }
}

component MagnetDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in-out property <string> magnet-uri: "";
    callback submitted(string);
    callback cancelled();

    visible: visible-dialog; z: 100;
    background: #00000099;

    Rectangle {
        width: 440px; height: 180px;
        background: #1e2430; border-radius: 10px;
        border-width: 1px; border-color: #3a4560;
        VerticalLayout {
            padding: 24px; spacing: 14px;
            Text { text: "Add Magnet Link"; color: #dce4f5; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
            LineEdit { horizontal-stretch: 1; placeholder-text: "magnet:?xt=urn:btih:..."; text <=> magnet-uri; }
            HorizontalLayout {
                spacing: 12px; alignment: center;
                Button { text: "OK"; clicked => { if (magnet-uri != "") { submitted(magnet-uri); magnet-uri = ""; } } }
                Button { text: "Cancel"; clicked => { magnet-uri = ""; cancelled(); } }
            }
        }
    }
}


component SettingsDialog inherits Rectangle {
    in property <bool> visible-dialog;
    property <string> refresh-interval-str: "\{cfg-refresh-interval}";
    in-out property <string> selected-language: "en";
    in-out property <int> settings-tab: 1;
    callback language-changed(string);
    callback saved();
    callback cancelled();
    callback pick-dl-script-path();
    callback pick-seed-script-path();
    in-out property <bool> cfg-speed-up-enabled: false;
    in-out property <int> cfg-speed-up-kbs: 0;
    in-out property <bool> cfg-speed-down-enabled: false;
    in-out property <int> cfg-speed-down-kbs: 0;
    in-out property <bool> cfg-alt-speed-enabled: false;
    in-out property <int> cfg-alt-speed-up-kbs: 0;
    in-out property <int> cfg-alt-speed-down-kbs: 0;
    in-out property <bool> cfg-alt-speed-schedule: false;
    in-out property <int> cfg-alt-speed-time-begin: 540;
    in-out property <int> cfg-alt-speed-time-end: 1020;
    in-out property <bool> cfg-speed-day-mon: true;
    in-out property <bool> cfg-speed-day-tue: true;
    in-out property <bool> cfg-speed-day-wed: true;
    in-out property <bool> cfg-speed-day-thu: true;
    in-out property <bool> cfg-speed-day-fri: true;
    in-out property <bool> cfg-speed-day-sat: false;
    in-out property <bool> cfg-speed-day-sun: false;
    in-out property <bool> cfg-dl-watch-dir-enabled: false;
    in-out property <string> cfg-dl-watch-dir: "";
    in-out property <bool> cfg-dl-show-dialog: true;
    in-out property <bool> cfg-dl-start-added: true;
    in-out property <bool> cfg-dl-trash-torrent: false;
    in-out property <string> cfg-dl-dir: "";
    in-out property <int> cfg-dl-queue-max: 5;
    in-out property <int> cfg-dl-seed-ratio-limit-min: 30;
    in-out property <bool> cfg-dl-part-ext: true;
    in-out property <bool> cfg-dl-incomplete-dir-enabled: false;
    in-out property <string> cfg-dl-incomplete-dir: "";
    in-out property <bool> cfg-dl-done-script-enabled: false;
    in-out property <string> cfg-dl-done-script: "";
    in-out property <bool> cfg-seed-ratio-enabled: false;
    in-out property <int> cfg-seed-ratio: 200;
    in-out property <bool> cfg-seed-idle-enabled: false;
    in-out property <int> cfg-seed-idle-min: 30;
    in-out property <bool> cfg-seed-done-script-enabled: false;
    in-out property <string> cfg-seed-done-script: "";
    in-out property <int> cfg-net-port: 51413;
    in-out property <bool> cfg-net-random-port: true;
    in-out property <bool> cfg-net-port-forward: true;
    in-out property <int> cfg-net-max-peers-torrent: 50;
    in-out property <int> cfg-net-max-peers-total: 200;
    in-out property <bool> cfg-net-utp: true;
    in-out property <bool> cfg-net-pex: true;
    in-out property <bool> cfg-net-dht: true;
    in-out property <bool> cfg-net-lpd: true;
    in-out property <string> cfg-net-default-trackers: "";
    in-out property <int> cfg-priv-encryption: 1;
    in-out property <bool> cfg-priv-blocklist-enabled: false;
    in-out property <string> cfg-priv-blocklist-url: "";
    in-out property <bool> cfg-priv-blocklist-auto-update: false;
    in-out property <int> cfg-priv-blocklist-entries: 0;
    in-out property <bool> cfg-remote-enabled: true;
    in-out property <int> cfg-remote-port: 9091;
    in-out property <bool> cfg-remote-auth: false;
    in-out property <string> cfg-remote-username: "";
    in-out property <string> cfg-remote-password: "";
    in-out property <bool> cfg-remote-whitelist-enabled: true;
    in-out property <string> cfg-remote-whitelist: "";
    in-out property <bool> cfg-autostart: false;
    in-out property <bool> cfg-suspend: false;
    in-out property <bool> cfg-start-minimized: false;
    in-out property <bool> cfg-delete-torrent: false;
    in-out property <int> cfg-refresh-interval: 5;
    in-out property <int> cfg-on-close: 0;
    in-out property <bool> cfg-notify-add: true;
    in-out property <bool> cfg-notify-complete: true;
    in-out property <bool> cfg-notify-sound: true;
    in-out property <int> cfg-theme: 0;
    in-out property <bool> cfg-tb-add: true;
    in-out property <bool> cfg-tb-magnet: true;
    in-out property <bool> cfg-tb-create: true;
    in-out property <bool> cfg-tb-rehash: true;
    in-out property <bool> cfg-tb-start-sel: true;
    in-out property <bool> cfg-tb-pause-sel: true;
    in-out property <bool> cfg-tb-start-all: true;
    in-out property <bool> cfg-tb-pause-all: true;
    in-out property <bool> cfg-lp-status: true;
    in-out property <bool> cfg-lp-disks: true;
    in-out property <bool> cfg-lp-trackers: false;
    in-out property <bool> cfg-lp-webtorrents: false;
    in-out property <bool> cfg-lp-tags: false;
    in-out property <bool> cfg-lp-created: false;

    property <int> priv-encryption-expanded: -1;
    visible: visible-dialog; z: 100;
    background: #00000099;

    // Connection profiles states
    in-out property <bool> is-local-config-detected: true;
    in-out property <bool> is-editing-profile: false;
    in-out property <int> editing-id: 0;
    in-out property <string> edit-profile-name: "";
    in-out property <string> edit-profile-host: "127.0.0.1";
    in-out property <int> edit-profile-port: 9091;
    in-out property <bool> edit-profile-auth: false;
    in-out property <string> edit-profile-username: "admin";
    in-out property <string> edit-profile-password: "";

    // Delete Modal state
    in-out property <bool> show-delete-dialog: false;
    in-out property <int> delete-target-id: 0;
    in-out property <string> delete-target-name: "";
    in-out property <int> delete-countdown-val: 5;

    // Simulated profiles slots
    in-out property <bool> has-profile-1: false;
    in-out property <string> p1-name: "Banana Pi Server";
    in-out property <string> p1-host: "192.168.1.15";
    in-out property <int> p1-port: 9091;
    in-out property <bool> p1-auth: true;
    in-out property <string> p1-username: "admin";
    in-out property <string> p1-password: "";
    in-out property <bool> p1-active: false;

    // Profile 2
    in-out property <bool> has-profile-2: false;
    in-out property <string> p2-name: "Cactus NAS";
    in-out property <string> p2-host: "10.0.0.10";
    in-out property <int> p2-port: 9091;
    in-out property <bool> p2-auth: false;
    in-out property <string> p2-username: "guest";
    in-out property <string> p2-password: "";
    in-out property <bool> p2-active: false;

    in-out property <bool> local-host-active: true;

    Timer {
        interval: 1000ms;
        running: show-delete-dialog && delete-countdown-val > 0;
        triggered() => {
            delete-countdown-val = delete-countdown-val - 1;
        }
    }

    Rectangle {
        width: 640px;
        height: settings-tab == 1 ? 490px :
                settings-tab == 2 ? 520px :
                settings-tab == 3 ? 480px :
                settings-tab == 4 ? 640px :
                settings-tab == 5 ? 460px :
                settings-tab == 0 ? 480px :
                settings-tab == 6 ? 480px :
                settings-tab == 7 ? 440px :
                settings-tab == 8 ? 540px :
                440px;
        animate height { duration: 180ms; easing: ease-in-out; }
        background: #181922; border-radius: 8px;
        border-width: 1px; border-color: #2a2b38;
        VerticalLayout {
            padding: 0px; spacing: 0px;
            
            // Header bar
            HorizontalLayout {
                height: 52px; padding-left: 20px; padding-right: 20px;
                Text {
                    text: selected-language == "ru" ? "Настройки" : "Settings";
                    color: #f1f5f9; font-size: 14px; font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            
            Rectangle { height: 1px; background: #2a2b38; }
            
            HorizontalLayout {
                vertical-stretch: 1; spacing: 0px;
                
                // Left Sidebar
                Rectangle {
                    width: 170px; background: transparent;
                    VerticalLayout {
                        padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;
                        spacing: 2px; alignment: start;
                        for tab-info in [
                            {ico: "⏲", n: 1, label-en: "Speed", label-ru: "Скорость"},
                            {ico: "⬇", n: 2, label-en: "Downloading", label-ru: "Загрузка"},
                            {ico: "⬆", n: 3, label-en: "Seeding", label-ru: "Раздача"},
                            {ico: "🌐", n: 4, label-en: "Network", label-ru: "Сеть"},
                            {ico: "🛡", n: 5, label-en: "Privacy", label-ru: "Приватность"},
                            {ico: "🖥", n: 0, label-en: "System", label-ru: "Система"},
                            {ico: "🔗", n: 6, label-en: "Remote", label-ru: "Remote"},
                            {ico: "🎚", n: 7, label-en: "Interface", label-ru: "Интерфейс"},
                        ]: Rectangle {
                            height: 34px; border-radius: 6px;
                            background: settings-tab == tab-info.n ? #252739 : transparent;
                            TouchArea { clicked => { settings-tab = tab-info.n; } }
                            HorizontalLayout {
                                spacing: 10px; padding-left: 14px; alignment: start;
                                Rectangle {
                                    width: 18px;
                                    opacity: settings-tab == tab-info.n ? 1.0 : 0.35;
                                    Text {
                                        text: tab-info.ico;
                                        color: settings-tab == tab-info.n ? (
                                            tab-info.n == 1 ? #10b981 : (
                                            tab-info.n == 2 ? #3b82f6 : (
                                            tab-info.n == 3 ? #8b5cf6 : (
                                            tab-info.n == 4 ? #f59e0b : (
                                            tab-info.n == 5 ? #0ea5e9 : (
                                            tab-info.n == 0 ? #14b8a6 : (
                                            tab-info.n == 6 ? #ec4899 : #f43f5e
                                            ))))))) : #4d516d;
                                        font-size: tab-info.n == 1 ? 21px : 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? tab-info.label-ru : tab-info.label-en;
                                    color: settings-tab == tab-info.n ? #f1f5f9 : #8189a0;
                                    font-size: 12px;
                                    font-weight: settings-tab == tab-info.n ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        
                        // Separator above bottom About
                        Rectangle {
                            height: 13px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                        }
                        
                        // About Client at the bottom of the column
                        Rectangle {
                            height: 34px; border-radius: 6px;
                            background: settings-tab == 8 ? #252739 : transparent;
                            TouchArea { clicked => { settings-tab = 8; } }
                            HorizontalLayout {
                                spacing: 10px; padding-left: 14px; alignment: start;
                                Rectangle {
                                    width: 18px;
                                    opacity: settings-tab == 8 ? 1.0 : 0.35;
                                    Text {
                                        text: "ⓘ";
                                        color: settings-tab == 8 ? #a855f7 : #4d516d;
                                        font-size: 16px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "О программе" : "About Client";
                                    color: settings-tab == 8 ? #f1f5f9 : #8189a0;
                                    font-size: 12px;
                                    font-weight: settings-tab == 8 ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                
                // Border dividing sidebar and pane
                Rectangle { width: 1px; background: #2a2b38; }
                
                // Right panel content
                Rectangle {
                    vertical-stretch: 1; background: transparent;
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            // 0. SYSTEM
                            if settings-tab == 0: VerticalLayout {
                            padding: 20px; spacing: 14px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-suspend = !cfg-suspend; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-suspend ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-suspend ? #3f72f6 : #383a54;
                                            if cfg-suspend : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Запрещать переход в спящий режим при активных торрентах" : "Prevent sleep mode when torrents are active";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-autostart = !cfg-autostart; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-autostart ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-autostart ? #3f72f6 : #383a54;
                                            if cfg-autostart : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Автозапуск при входе в систему" : "Start Transmission down on login";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-start-minimized = !cfg-start-minimized; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-start-minimized ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-start-minimized ? #3f72f6 : #383a54;
                                            if cfg-start-minimized : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Запускать свёрнутым в трей" : "Start minimized to tray";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 16px; height: 32px;
                                Text {
                                    text: selected-language == "ru" ? "При закрытии окна:" : "On window close:";
                                    color: #939cb0; font-size: 12px; vertical-alignment: center; width: 140px;
                                }
                                Rectangle {
                                    width: selected-language == "ru" ? 245px : 180px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    
                                    on-close-popup := PopupWindow {
                                        x: 0; y: 34px; width: selected-language == "ru" ? 245px : 200px; height: 92px;
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: #282a36; border-radius: 4px; border-width: 1px; border-color: #383a4d;
                                            drop-shadow-blur: 8px; drop-shadow-color: #00000040; drop-shadow-offset-y: 4px;
                                            
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-onc0.has-hover ? #383a54 : transparent;
                                                    if cfg-on-close == 0: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Спрашивать + ждать трекеры" : "Ask + wait for trackers"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-on-close == 0 ? 600 : 400; }
                                                    ta-onc0 := TouchArea { clicked => { cfg-on-close = 0; on-close-popup.close(); } }
                                                }
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-onc1.has-hover ? #383a54 : transparent;
                                                    if cfg-on-close == 1: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Сворачивать в трей" : "Minimize to tray"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-on-close == 1 ? 600 : 400; }
                                                    ta-onc1 := TouchArea { clicked => { cfg-on-close = 1; on-close-popup.close(); } }
                                                }
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-onc2.has-hover ? #383a54 : transparent;
                                                    if cfg-on-close == 2: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Закрывать немедленно" : "Close immediately"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-on-close == 2 ? 600 : 400; }
                                                    ta-onc2 := TouchArea { clicked => { cfg-on-close = 2; on-close-popup.close(); } }
                                                }
                                            }
                                        }
                                    }
                                    
                                    Text {
                                        text: cfg-on-close == 0 ? (selected-language == "ru" ? "Спрашивать + ждать трекеры" : "Ask + wait for trackers") :
                                              (cfg-on-close == 1 ? (selected-language == "ru" ? "Сворачивать в трей" : "Minimize to tray") :
                                                                   (selected-language == "ru" ? "Закрывать немедленно" : "Close immediately"));
                                        color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 12px;
                                    }
                                    
                                    Text {
                                        text: "⌄"; color: #a1a6b8; font-size: 16px; vertical-alignment: center; x: parent.width - 24px; y: parent.height / 2 - 10px;
                                    }
                                    
                                    TouchArea {
                                        clicked => { on-close-popup.show(); }
                                    }
                                }
                            }
                            
                            VerticalLayout {
                                spacing: 4px;
                                Rectangle { height: 4px; }
                                Text {
                                    text: selected-language == "ru" ? "УВЕДОМЛЕНИЯ" : "NOTIFICATIONS";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                    letter-spacing: 0.5px;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-notify-add = !cfg-notify-add; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-notify-add ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-notify-add ? #3f72f6 : #383a54;
                                            if cfg-notify-add : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Показывать уведомление после добавления торрентов" : "Show notification when adding torrents";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-notify-complete = !cfg-notify-complete; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-notify-complete ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-notify-complete ? #3f72f6 : #383a54;
                                            if cfg-notify-complete : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Показывать уведомление после завершения загрузки" : "Show notification when download completes";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-notify-sound = !cfg-notify-sound; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-notify-sound ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-notify-sound ? #3f72f6 : #383a54;
                                            if cfg-notify-sound : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Воспроизводить звуковое уведомление при завершении" : "Play sound notification upon complete";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        
                        // 1. SPEED LIMITS (PANE MATCHING SCREENSHOT 2)
                        if settings-tab == 1: VerticalLayout { padding: 24px; spacing: 0px; alignment: start;
                            VerticalLayout {
                                width: 420px; spacing: 10px; alignment: start;
                                
                                // ── SPEED LIMITS ──────────────────────────────────────────────────────────
                                Text { text: "SPEED LIMITS"; color: #626a80; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }

                                // Upload row
                                HorizontalLayout { padding-left: 32px; spacing: 16px; alignment: start; height: 28px;
                                    // Checkbox
                                    Rectangle { width: 18px; height: 18px; border-radius: 4px;
                                        background: cfg-speed-up-enabled ? #4a7cf7 : transparent;
                                        border-width: 1px; border-color: cfg-speed-up-enabled ? #4a7cf7 : #343858;
                                        up-cb := TouchArea { clicked => { cfg-speed-up-enabled = !cfg-speed-up-enabled; } }
                                        if cfg-speed-up-enabled: Text { text: "✓"; color: #fff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "Upload Limit (MB/s):";  color: #939cb0; font-size: 13px; vertical-alignment: center; width: 140px; }
                                    
                                    HorizontalLayout {
                                        horizontal-stretch: 1; alignment: end; spacing: 12px;
                                        // Input field
                                        Rectangle { width: 54px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text { text: cfg-speed-up-kbs + ""; color: cfg-speed-up-enabled ? #dce4f5 : #4e556e; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        // − button
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: up-min-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            up-min-ta := TouchArea { clicked => { if cfg-speed-up-enabled { cfg-speed-up-kbs = Math.max(0, cfg-speed-up-kbs - 1); } } }
                                            Text { text: "−"; color: #8f97b8; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        // + button
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: up-pls-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            up-pls-ta := TouchArea { clicked => { if cfg-speed-up-enabled { cfg-speed-up-kbs = Math.min(9999, cfg-speed-up-kbs + 1); } } }
                                            Text { text: "+"; color: #8f97b8; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // Download row
                                HorizontalLayout { padding-left: 32px; spacing: 16px; alignment: start; height: 28px;
                                    Rectangle { width: 18px; height: 18px; border-radius: 4px;
                                        background: cfg-speed-down-enabled ? #4a7cf7 : transparent;
                                        border-width: 1px; border-color: cfg-speed-down-enabled ? #4a7cf7 : #343858;
                                        dn-cb := TouchArea { clicked => { cfg-speed-down-enabled = !cfg-speed-down-enabled; } }
                                        if cfg-speed-down-enabled: Text { text: "✓"; color: #fff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "Download Limit (MB/s):";  color: #939cb0; font-size: 13px; vertical-alignment: center; width: 140px; }
                                    
                                    HorizontalLayout {
                                        horizontal-stretch: 1; alignment: end; spacing: 12px;
                                        Rectangle { width: 54px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text { text: cfg-speed-down-kbs + ""; color: cfg-speed-down-enabled ? #dce4f5 : #4e556e; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: dn-min-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            dn-min-ta := TouchArea { clicked => { if cfg-speed-down-enabled { cfg-speed-down-kbs = Math.max(0, cfg-speed-down-kbs - 1); } } }
                                            Text { text: "−"; color: #8f97b8; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: dn-pls-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            dn-pls-ta := TouchArea { clicked => { if cfg-speed-down-enabled { cfg-speed-down-kbs = Math.min(9999, cfg-speed-down-kbs + 1); } } }
                                            Text { text: "+"; color: #8f97b8; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                                
                                Rectangle { height: 12px; background: transparent; } // padding
                                Rectangle { height: 1px; background: #2a2b38; }
                                Rectangle { height: 12px; background: transparent; } // padding

                                // ── SPECIAL ALTERNATIVE LIMITS ────────────────────────────────────────────
                                Text { text: "SPECIAL ALTERNATIVE LIMITS"; color: #626a80; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }

                                // Override checkbox row
                                HorizontalLayout { spacing: 14px; height: 28px; alignment: start;
                                    Rectangle { width: 18px; height: 18px; border-radius: 4px;
                                        background: cfg-alt-speed-enabled ? #4a7cf7 : transparent;
                                        border-width: 1px; border-color: cfg-alt-speed-enabled ? #4a7cf7 : #343858;
                                        alt-cb := TouchArea { clicked => { cfg-alt-speed-enabled = !cfg-alt-speed-enabled; } }
                                        if cfg-alt-speed-enabled: Text { text: "✓"; color: #fff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "Override normal limits by schedule or manually"; color: #e4e7f2; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                }

                                // Alt Upload row
                                HorizontalLayout { padding-left: 34px; spacing: 14px; alignment: start; height: 28px;
                                    Text { text: "Upload (MB/s):"; color: cfg-alt-speed-enabled ? #7a8296 : #4e556e; font-size: 13px; vertical-alignment: center; width: 120px; }
                                    
                                    HorizontalLayout {
                                        horizontal-stretch: 1; alignment: end; spacing: 12px;
                                        Rectangle { width: 54px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text { text: cfg-alt-speed-up-kbs + ""; color: cfg-alt-speed-enabled ? #dce4f5 : #4e556e; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: au-min-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            au-min-ta := TouchArea { clicked => { if cfg-alt-speed-enabled { cfg-alt-speed-up-kbs = Math.max(0, cfg-alt-speed-up-kbs - 1); } } }
                                            Text { text: "−"; color: cfg-alt-speed-enabled ? #8f97b8 : #4e556e; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: au-pls-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            au-pls-ta := TouchArea { clicked => { if cfg-alt-speed-enabled { cfg-alt-speed-up-kbs = Math.min(9999, cfg-alt-speed-up-kbs + 1); } } }
                                            Text { text: "+"; color: cfg-alt-speed-enabled ? #8f97b8 : #4e556e; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // Alt Download row
                                HorizontalLayout { padding-left: 34px; spacing: 14px; alignment: start; height: 28px;
                                    Text { text: "Download (MB/s):"; color: cfg-alt-speed-enabled ? #7a8296 : #4e556e; font-size: 13px; vertical-alignment: center; width: 120px; }
                                    
                                    HorizontalLayout {
                                        horizontal-stretch: 1; alignment: end; spacing: 12px;
                                        Rectangle { width: 54px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text { text: cfg-alt-speed-down-kbs + ""; color: cfg-alt-speed-enabled ? #dce4f5 : #4e556e; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: ad-min-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            ad-min-ta := TouchArea { clicked => { if cfg-alt-speed-enabled { cfg-alt-speed-down-kbs = Math.max(0, cfg-alt-speed-down-kbs - 1); } } }
                                            Text { text: "−"; color: cfg-alt-speed-enabled ? #8f97b8 : #4e556e; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle { width: 28px; height: 28px; border-radius: 4px; background: ad-pls-ta.has-hover ? #252d40 : transparent; border-width: 1px; border-color: #343858;
                                            ad-pls-ta := TouchArea { clicked => { if cfg-alt-speed-enabled { cfg-alt-speed-down-kbs = Math.min(9999, cfg-alt-speed-down-kbs + 1); } } }
                                            Text { text: "+"; color: cfg-alt-speed-enabled ? #8f97b8 : #4e556e; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                // By schedule row
                                HorizontalLayout { padding-left: 34px; spacing: 14px; alignment: start; height: 28px;
                                    Rectangle { width: 18px; height: 18px; border-radius: 4px;
                                        background: cfg-alt-speed-schedule ? #4a7cf7 : transparent;
                                        border-width: 1px; border-color: cfg-alt-speed-schedule ? #4a7cf7 : #343858;
                                        sched-cb := TouchArea { clicked => { if cfg-alt-speed-enabled { cfg-alt-speed-schedule = !cfg-alt-speed-schedule; } } }
                                        if cfg-alt-speed-schedule: Text { text: "✓"; color: #fff; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: "By schedule:"; color: cfg-alt-speed-enabled ? #7a8296 : #4e556e; font-size: 13px; vertical-alignment: center; width: 100px; }
                                    
                                    HorizontalLayout {
                                        horizontal-stretch: 1; alignment: end; spacing: 12px;
                                        // Time begin
                                        Rectangle { width: 60px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text {
                                                text: (cfg-alt-speed-time-begin / 60) + ":" + (Math.mod(cfg-alt-speed-time-begin, 60) < 10 ? "0" : "") + Math.mod(cfg-alt-speed-time-begin, 60);
                                                color: cfg-alt-speed-enabled ? #dce4f5 : #4e556e; font-size: 13px;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                        Text { text: "to"; color: #7a8296; font-size: 13px; vertical-alignment: center; }
                                        // Time end
                                        Rectangle { width: 60px; height: 28px; border-radius: 4px; background: transparent; border-width: 1px; border-color: #343858;
                                            Text {
                                                text: (cfg-alt-speed-time-end / 60) + ":" + (Math.mod(cfg-alt-speed-time-end, 60) < 10 ? "0" : "") + Math.mod(cfg-alt-speed-time-end, 60);
                                                color: cfg-alt-speed-enabled ? #dce4f5 : #4e556e; font-size: 13px;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Days of week
                                HorizontalLayout { alignment: start; padding-left: 120px; width: 100%;
                                    HorizontalLayout { spacing: 6px;
                                        for day-info in [
                                            {label: "Mo", prop: 0},
                                            {label: "Tu", prop: 1},
                                            {label: "We", prop: 2},
                                            {label: "Th", prop: 3},
                                            {label: "Fr", prop: 4},
                                            {label: "Sa", prop: 5},
                                            {label: "Su", prop: 6},
                                        ]: Rectangle {
                                            property <bool> day-on: day-info.prop == 0 ? cfg-speed-day-mon
                                                : day-info.prop == 1 ? cfg-speed-day-tue
                                                : day-info.prop == 2 ? cfg-speed-day-wed
                                                : day-info.prop == 3 ? cfg-speed-day-thu
                                                : day-info.prop == 4 ? cfg-speed-day-fri
                                                : day-info.prop == 5 ? cfg-speed-day-sat
                                                : cfg-speed-day-sun;
                                            width: 32px; height: 32px; border-radius: 4px;
                                            background: day-on ? transparent : transparent;
                                            border-width: 1px; border-color: day-on ? #f1f5f9 : #343858;
                                            animate border-color { duration: 100ms; }
                                            day-ta := TouchArea {
                                                clicked => {
                                                    if cfg-alt-speed-enabled {
                                                        if (day-info.prop == 0) { cfg-speed-day-mon = !cfg-speed-day-mon; }
                                                        else if (day-info.prop == 1) { cfg-speed-day-tue = !cfg-speed-day-tue; }
                                                        else if (day-info.prop == 2) { cfg-speed-day-wed = !cfg-speed-day-wed; }
                                                        else if (day-info.prop == 3) { cfg-speed-day-thu = !cfg-speed-day-thu; }
                                                        else if (day-info.prop == 4) { cfg-speed-day-fri = !cfg-speed-day-fri; }
                                                        else if (day-info.prop == 5) { cfg-speed-day-sat = !cfg-speed-day-sat; }
                                                        else { cfg-speed-day-sun = !cfg-speed-day-sun; }
                                                    }
                                                }
                                            }
                                            Text { text: day-info.label; color: day-on ? #dce4f5 : #4e556e; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // 2. DOWNLOADING CONFIG
                        if settings-tab == 2: VerticalLayout {
                            padding: 24px; spacing: 20px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: selected-language == "ru" ? "ДОБАВЛЕНИЕ" : "ADDITIONS PREFERENCES";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Checkbox: Import torrents
                            HorizontalLayout {
                                spacing: 12px; height: 32px; alignment: start;
                                TouchArea {
                                    clicked => { cfg-dl-watch-dir-enabled = !cfg-dl-watch-dir-enabled; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-watch-dir-enabled ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-watch-dir-enabled ? #3f72f6 : #383a54;
                                        if cfg-dl-watch-dir-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Автоматически добавлять торрент-файлы из:" : "Automatically import torrents from folder:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                    width: 230px; wrap: word-wrap;
                                }
                                
                                if cfg-dl-watch-dir-enabled: Rectangle {
                                    width: 150px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    LineEdit {
                                        width: 100%; height: 100%;
                                        text <=> cfg-dl-watch-dir;
                                    }
                                }
                            }
                            
                            // Checkbox: Show torrent options dialog
                            HorizontalLayout {
                                spacing: 12px; height: 24px;
                                TouchArea {
                                    clicked => { cfg-dl-show-dialog = !cfg-dl-show-dialog; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-show-dialog ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-show-dialog ? #3f72f6 : #383a54;
                                        if cfg-dl-show-dialog : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Показывать диалог параметров торрента" : "Show torrent options dialog";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                }
                            }
                            
                            // Checkbox: Instantly trigger downloads
                            HorizontalLayout {
                                spacing: 12px; height: 24px;
                                TouchArea {
                                    clicked => { cfg-dl-start-added = !cfg-dl-start-added; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-start-added ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-start-added ? #3f72f6 : #383a54;
                                        if cfg-dl-start-added : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Запускать добавленные торренты" : "Instantly trigger downloads after import";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                }
                            }
                            
                            // Checkbox: Trash imported torrents
                            HorizontalLayout {
                                spacing: 12px; height: 24px;
                                TouchArea {
                                    clicked => { cfg-dl-trash-torrent = !cfg-dl-trash-torrent; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-trash-torrent ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-trash-torrent ? #3f72f6 : #383a54;
                                        if cfg-dl-trash-torrent : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Убрать торрент-файл в корзину" : "Safely trash imported .torrents files";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                }
                            }
                            
                            // Default download folder input
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px; height: 32px; alignment: start;
                                    Text {
                                        text: selected-language == "ru" ? "Папка по умолчанию:" : "Default download location:";
                                        color: #bfcade; font-size: 13px; vertical-alignment: center;
                                        width: 180px;
                                    }
                                    Rectangle {
                                        width: 140px; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        LineEdit {
                                            width: 100%; height: 100%;
                                            text <=> cfg-dl-dir;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px;
                                        background: #1a1b2a; border-width: 1px; border-color: #282a41;
                                        Text { text: "📁"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start; padding-left: 188px;
                                    Text {
                                        text: selected-language == "ru" ? "* 1.76 ТБ свободно на /dev/sda" : "* 1.76 TB free space on /dev/sda";
                                        color: #555b70; font-size: 11px;
                                    }
                                }
                            }
                            
                            // Section: Download Queue
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 10px; }
                                Text {
                                    text: selected-language == "ru" ? "ОЧЕРЕДЬ ЗАГРУЗКИ" : "ACTIVE DOWNLOADS QUEUE";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Max concurrent downloads
                            HorizontalLayout {
                                spacing: 12px; height: 32px;
                                Text {
                                    text: selected-language == "ru" ? "Максимум активных загрузок:" : "Maximum concurrent downloads:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center; width: 230px;
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle {
                                        width: 70px; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            text: cfg-dl-queue-max;
                                            color: #e2e8f0; font-size: 13px;
                                            vertical-alignment: center; x: 12px;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #343858;
                                        Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-dl-queue-max > 0) { cfg-dl-queue-max = cfg-dl-queue-max - 1; } } }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #343858;
                                        Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { cfg-dl-queue-max = cfg-dl-queue-max + 1; } }
                                    }
                                }
                            }
                            
                            // Seed ratio limit min
                            HorizontalLayout {
                                spacing: 12px; height: 32px;
                                Text {
                                    text: selected-language == "ru" ? "Данные раздачи за N мин активности:" : "Seed ratio limit min:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center; width: 230px;
                                }
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle {
                                        width: 70px; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            text: cfg-dl-seed-ratio-limit-min;
                                            color: #e2e8f0; font-size: 13px;
                                            vertical-alignment: center; x: 12px;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #343858;
                                        Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-dl-seed-ratio-limit-min > 0) { cfg-dl-seed-ratio-limit-min = cfg-dl-seed-ratio-limit-min - 1; } } }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #343858;
                                        Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { cfg-dl-seed-ratio-limit-min = cfg-dl-seed-ratio-limit-min + 1; } }
                                    }
                                }
                            }
                            
                            // Section: Download Process
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 10px; }
                                Text {
                                    text: selected-language == "ru" ? "ПРОЦЕСС ЗАГРУЗКИ" : "DOWNLOAD PROCESS";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Checkbox: Append .part
                            HorizontalLayout {
                                spacing: 12px; height: 24px; alignment: stretch;
                                TouchArea {
                                    clicked => { cfg-dl-part-ext = !cfg-dl-part-ext; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-part-ext ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-part-ext ? #3f72f6 : #383a54;
                                        if cfg-dl-part-ext : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Добавлять «.part» к именам незавершённых файлов" : "Append «.part» to incomplete files names";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                }
                            }
                            
                            // Checkbox: Incomplete Dir
                            HorizontalLayout {
                                spacing: 12px; height: 32px; alignment: start;
                                TouchArea {
                                    clicked => { cfg-dl-incomplete-dir-enabled = !cfg-dl-incomplete-dir-enabled; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-incomplete-dir-enabled ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-incomplete-dir-enabled ? #3f72f6 : #383a54;
                                        if cfg-dl-incomplete-dir-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Сохранять незавершённые торренты в:" : "Save incomplete torrents to:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                    width: 230px; wrap: word-wrap;
                                }
                                
                                if cfg-dl-incomplete-dir-enabled: Rectangle {
                                    width: 150px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    LineEdit {
                                        width: 100%; height: 100%;
                                        text <=> cfg-dl-incomplete-dir;
                                    }
                                }
                                if !cfg-dl-incomplete-dir-enabled: Rectangle {
                                    width: 150px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    Text {
                                        x: 8px; vertical-alignment: center; text: selected-language == "ru" ? "/Media" : "/Media"; color: #3e445e; font-size: 13px;
                                    }
                                }
                            }
                            
                            // Checkbox: Done Script
                            HorizontalLayout {
                                spacing: 12px; height: 32px; alignment: start;
                                TouchArea {
                                    clicked => { cfg-dl-done-script-enabled = !cfg-dl-done-script-enabled; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-dl-done-script-enabled ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-dl-done-script-enabled ? #3f72f6 : #383a54;
                                        if cfg-dl-done-script-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Выполнять сценарий по окончании загрузки:" : "Execute action when torrent is done:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                    width: 230px; wrap: word-wrap;
                                }
                                
                                if cfg-dl-done-script-enabled: HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle {
                                        width: 110px; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        LineEdit {
                                            width: 100%; height: 100%;
                                            text <=> cfg-dl-done-script;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px;
                                        background: #1a1b2a; border-width: 1px; border-color: #282a41;
                                        Text { text: "📁"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { pick-dl-script-path(); } }
                                    }
                                }
                                if !cfg-dl-done-script-enabled: HorizontalLayout {
                                    alignment: start;
                                    Rectangle {
                                        width: 150px; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            x: 8px; vertical-alignment: center; text: selected-language == "ru" ? "путь к скрипту" : "path to script"; color: #3e445e; font-size: 13px;
                                        }
                                    }
                                }
                            }
                        }
                        
                        // 3. SEEDING LIMITS
                        if settings-tab == 3: VerticalLayout {
                            padding: 24px; spacing: 20px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: selected-language == "ru" ? "ОГРАНИЧЕНИЯ РАЗДАЧИ" : "SEEDING BOUNDARIES";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Seeding limit ratio
                            HorizontalLayout {
                                spacing: 12px; height: 26px;
                                HorizontalLayout {
                                    spacing: 12px; width: 230px;
                                    TouchArea {
                                        clicked => { cfg-seed-ratio-enabled = !cfg-seed-ratio-enabled; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-seed-ratio-enabled ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-seed-ratio-enabled ? #3f72f6 : #383a54;
                                            if cfg-seed-ratio-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Прекратить раздачу при рейтинге:" : "Stop seeding under ratio:";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle {
                                        width: 50px; height: 26px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            text: (cfg-seed-ratio / 100) + "." + (Math.mod(cfg-seed-ratio, 100) / 10);
                                            color: #e2e8f0; font-size: 12px;
                                            vertical-alignment: center; x: 12px;
                                        }
                                    }
                                    Rectangle {
                                        width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-seed-ratio-enabled && cfg-seed-ratio > 10) { cfg-seed-ratio = cfg-seed-ratio - 10; } } }
                                    }
                                    Rectangle {
                                        width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-seed-ratio-enabled) { cfg-seed-ratio = cfg-seed-ratio + 10; } } }
                                    }
                                }
                            }
                            
                            // Seeding limit idle
                            HorizontalLayout {
                                spacing: 12px; height: 26px;
                                HorizontalLayout {
                                    spacing: 12px; width: 230px;
                                    TouchArea {
                                        clicked => { cfg-seed-idle-enabled = !cfg-seed-idle-enabled; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-seed-idle-enabled ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-seed-idle-enabled ? #3f72f6 : #383a54;
                                            if cfg-seed-idle-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Прекратить раздачу при простое (мин):" : "Stop seeding if idle (minutes):";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Rectangle {
                                        width: 50px; height: 26px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            text: cfg-seed-idle-min;
                                            color: #e2e8f0; font-size: 12px;
                                            vertical-alignment: center; x: 12px;
                                        }
                                    }
                                    Rectangle {
                                        width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-seed-idle-enabled && cfg-seed-idle-min > 0) { cfg-seed-idle-min = cfg-seed-idle-min - 1; } } }
                                    }
                                    Rectangle {
                                        width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                        TouchArea { clicked => { if (cfg-seed-idle-enabled) { cfg-seed-idle-min = cfg-seed-idle-min + 1; } } }
                                    }
                                }
                            }
                            // Checkbox: Done Script for Seeding
                            HorizontalLayout {
                                spacing: 12px; height: 32px; alignment: stretch;
                                TouchArea {
                                    clicked => { cfg-seed-done-script-enabled = !cfg-seed-done-script-enabled; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-seed-done-script-enabled ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-seed-done-script-enabled ? #3f72f6 : #383a54;
                                        if cfg-seed-done-script-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Выполнять сценарий по окончании раздачи:" : "Call script when torrent is done seeding:";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                    width: 260px;
                                }
                                
                                if cfg-seed-done-script-enabled: HorizontalLayout {
                                    spacing: 8px; horizontal-stretch: 1;
                                    Rectangle {
                                        horizontal-stretch: 1; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        LineEdit {
                                            width: 100%; height: 100%;
                                            text <=> cfg-seed-done-script;
                                        }
                                    }
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 4px;
                                        background: #1a1b2a; border-width: 1px; border-color: #282a41;
                                        Text { text: "📁"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { pick-seed-script-path(); } }
                                    }
                                }
                                if !cfg-seed-done-script-enabled: HorizontalLayout {
                                    spacing: 8px; horizontal-stretch: 1;
                                    Rectangle {
                                        horizontal-stretch: 1; height: 32px; border-radius: 4px;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        Text {
                                            x: 8px; vertical-alignment: center; text: selected-language == "ru" ? "путь к скрипту" : "path to script"; color: #3e445e; font-size: 13px;
                                        }
                                    }
                                }
                            }
                        }
                        
                        // 4. NETWORK (PORTS & PEERS)
                        if settings-tab == 4: VerticalLayout {
                            padding: 24px; spacing: 12px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: selected-language == "ru" ? "ПРОСЛУШИВАНИЕ ПОРТА" : "INCOMING LISTENING PORT";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Group 1: Listening port and checkboxes
                            VerticalLayout {
                                spacing: 8px;
                                
                                // Listening Port
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px; height: 28px; alignment: start;
                                        Text {
                                            text: selected-language == "ru" ? "Порт входящих подключений:" : "Peer listening port:";
                                            color: #939cb0; font-size: 12px; vertical-alignment: center; width: selected-language == "ru" ? 165px : 135px;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px; alignment: start;
                                            Rectangle {
                                                width: 50px; height: 26px; border-radius: 4px;
                                                background: #171825; border-width: 1px; border-color: #2c2d42;
                                                Text {
                                                    text: cfg-net-port; color: #e2e8f0; font-size: 12px;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                            Rectangle {
                                                width: 24px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                                Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                                TouchArea { clicked => { if (cfg-net-port > 0) { cfg-net-port = cfg-net-port - 1; } } }
                                            }
                                            Rectangle {
                                                width: 24px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                                Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                                TouchArea { clicked => { cfg-net-port = cfg-net-port + 1; } }
                                            }
                                            // Check button
                                            Rectangle {
                                                width: selected-language == "ru" ? 98px : 70px; height: 26px; border-radius: 4px;
                                                background: chk-ta.has-hover ? #253356 : #1b233a; border-width: 1px; border-color: #3f72f6;
                                                Text {
                                                    text: selected-language == "ru" ? "Проверить порт" : "Check";
                                                    color: #e2e8f0; font-size: 11px; font-weight: 600;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                                chk-ta := TouchArea { }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: selected-language == "ru" ? 225px : 180px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text { text: selected-language == "ru" ? "Состояние:" : "Status:"; color: #7a7e8e; font-size: 10px; }
                                            Text { text: selected-language == "ru" ? "неизвестно" : "unknown"; color: #b89c44; font-size: 10px; font-weight: 600; }
                                        }
                                    }
                                }
                                
                                // Random port on startup
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-random-port = !cfg-net-random-port; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-random-port ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-random-port ? #3f72f6 : #383a54;
                                            if cfg-net-random-port : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Устанавливать случайный порт при каждом запуске" : "Randomize port number on program launch";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                                
                                // UPnP
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-port-forward = !cfg-net-port-forward; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-port-forward ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-port-forward ? #3f72f6 : #383a54;
                                            if cfg-net-port-forward : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Использовать UPnP или NAT-PMP" : "Forward ports automatically using UPnP/NAT-PMP";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center;
                                    }
                                }
                            }
                            
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 2px; }
                                Text {
                                    text: selected-language == "ru" ? "ОГРАНИЧЕНИЯ УЧАСТНИКОВ" : "PEERS & CONNECTIONS BOUNDARIES";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Group 2: Peers boundaries
                            VerticalLayout {
                                spacing: 8px;
                                
                                // Max peers per torrent
                                HorizontalLayout {
                                    spacing: 12px; height: 26px;
                                    Text {
                                        text: selected-language == "ru" ? "Макс. участников на торрент:" : "Max peers per torrent:";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center; width: 170px;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        Rectangle {
                                            width: 50px; height: 26px; border-radius: 4px;
                                            background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text {
                                                text: cfg-net-max-peers-torrent;
                                                color: #e2e8f0; font-size: 12px;
                                                vertical-alignment: center; x: 12px;
                                            }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { if (cfg-net-max-peers-torrent > 5) { cfg-net-max-peers-torrent = cfg-net-max-peers-torrent - 5; } } }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { cfg-net-max-peers-torrent = cfg-net-max-peers-torrent + 5; } }
                                        }
                                    }
                                }
                                
                                // Max global peers
                                HorizontalLayout {
                                    spacing: 12px; height: 26px;
                                    Text {
                                        text: selected-language == "ru" ? "Общий максимум участников:" : "Global total peers limit:";
                                        color: #939cb0; font-size: 12px; vertical-alignment: center; width: 170px;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        Rectangle {
                                            width: 50px; height: 26px; border-radius: 4px;
                                            background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text {
                                                text: cfg-net-max-peers-total;
                                                color: #e2e8f0; font-size: 12px;
                                                vertical-alignment: center; x: 12px;
                                            }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text { text: "—"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { if (cfg-net-max-peers-total > 10) { cfg-net-max-peers-total = cfg-net-max-peers-total - 10; } } }
                                        }
                                        Rectangle {
                                            width: 26px; height: 26px; border-radius: 4px; background: #171825; border-width: 1px; border-color: #2c2d42;
                                            Text { text: "+"; color: #8e96aa; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; }
                                            TouchArea { clicked => { cfg-net-max-peers-total = cfg-net-max-peers-total + 10; } }
                                        }
                                    }
                                }
                            }
                        

                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 2px; }
                                Text {
                                    text: selected-language == "ru" ? "ПАРАМЕТРЫ" : "FEATURES";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            // Group 3: Features
                            VerticalLayout {
                                spacing: 8px;
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-utp = !cfg-net-utp; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-utp ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-utp ? #3f72f6 : #383a54;
                                            if cfg-net-utp : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: selected-language == "ru" ? "Использовать µTP для связи с участниками" : "Enable Micro Transport Protocol (µTP)"; color: #939cb0; font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-pex = !cfg-net-pex; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-pex ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-pex ? #3f72f6 : #383a54;
                                            if cfg-net-pex : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: selected-language == "ru" ? "Использовать PEX для обмена списками участников" : "Use Peer Exchange (PEX)"; color: #939cb0; font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-dht = !cfg-net-dht; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-dht ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-dht ? #3f72f6 : #383a54;
                                            if cfg-net-dht : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: selected-language == "ru" ? "Использовать DHT для обнаружения участников" : "Use Distributed Hash Table (DHT)"; color: #939cb0; font-size: 12px; vertical-alignment: center; }
                                }
                                
                                HorizontalLayout {
                                    spacing: 12px; height: 24px;
                                    TouchArea {
                                        clicked => { cfg-net-lpd = !cfg-net-lpd; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-net-lpd ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-net-lpd ? #3f72f6 : #383a54;
                                            if cfg-net-lpd : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: selected-language == "ru" ? "Использовать локальное обнаружение участников" : "Use Local Peer Discovery (LPD)"; color: #939cb0; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                            
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 2px; }
                                Text {
                                    text: selected-language == "ru" ? "СТАНДАРТНЫЕ ПУБЛИЧНЫЕ ТРЕКЕРЫ" : "DEFAULT PUBLIC TRACKERS";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            Rectangle {
                                height: 32px;
                                property <bool> is-expanded: le.has-focus;
                                Rectangle {
                                    y: parent.is-expanded ? -108px : 0px;
                                    width: 100%;
                                    height: parent.is-expanded ? 140px : 32px;
                                    border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    z: 100;
                                    animate height { duration: 150ms; easing: ease-in-out; }
                                    animate y { duration: 150ms; easing: ease-in-out; }
                                    le := LineEdit {
                                        width: 100%; height: 100%;
                                        placeholder-text: selected-language == "ru" ? "Добавьте трекеры, по одному на строку..." : "Add trackers here, one per line...";
                                        text <=> cfg-net-default-trackers;
                                    }
                                }
                            }
                        }
                        
                        // 5. PRIVACY
                        if settings-tab == 5: VerticalLayout {
                            padding: 24px; spacing: 20px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: selected-language == "ru" ? "ШИФРОВАНИЕ" : "PROTOCOL ENCRYPTION";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            HorizontalLayout {
                                spacing: 20px; height: 32px;
                                Text {
                                    text: selected-language == "ru" ? "Режим:" : "Encryption mode:";
                                    color: #939cb0; font-size: 12px; vertical-alignment: center; width: 140px;
                                }
                                Rectangle {
                                    width: selected-language == "ru" ? 240px : 180px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    
                                    encryption-popup := PopupWindow {
                                        x: 0; y: 34px; width: selected-language == "ru" ? 240px : 200px; height: 92px;
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: #282a36; border-radius: 4px; border-width: 1px; border-color: #383a4d;
                                            drop-shadow-blur: 8px; drop-shadow-color: #00000040; drop-shadow-offset-y: 4px;
                                            
                                            VerticalLayout {
                                                padding: 4px;
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-enc0.has-hover ? #383a54 : transparent;
                                                    if cfg-priv-encryption == 0: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Предпочитать шифрование" : "Prefer Encryption"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-priv-encryption == 0 ? 600 : 400; }
                                                    ta-enc0 := TouchArea { clicked => { cfg-priv-encryption = 0; encryption-popup.close(); } }
                                                }
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-enc1.has-hover ? #383a54 : transparent;
                                                    if cfg-priv-encryption == 1: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Требовать шифрование" : "Require Encryption"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-priv-encryption == 1 ? 600 : 400; }
                                                    ta-enc1 := TouchArea { clicked => { cfg-priv-encryption = 1; encryption-popup.close(); } }
                                                }
                                                Rectangle {
                                                    height: 28px; border-radius: 4px;
                                                    background: ta-enc2.has-hover ? #383a54 : transparent;
                                                    if cfg-priv-encryption == 2: Rectangle { x: 4px; width: 3px; height: 14px; y: 7px; background: #3ec4f0; border-radius: 1.5px; }
                                                    Text { text: selected-language == "ru" ? "Не шифровать" : "Disabled"; color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 14px; font-weight: cfg-priv-encryption == 2 ? 600 : 400; }
                                                    ta-enc2 := TouchArea { clicked => { cfg-priv-encryption = 2; encryption-popup.close(); } }
                                                }
                                            }
                                        }
                                    }
                                    
                                    Text {
                                        text: cfg-priv-encryption == 0 ? (selected-language == "ru" ? "Предпочитать шифрование" : "Prefer Encryption") :
                                              (cfg-priv-encryption == 1 ? (selected-language == "ru" ? "Требовать шифрование" : "Require Encryption") :
                                                                          (selected-language == "ru" ? "Не шифровать" : "Disabled"));
                                        color: #e2e8f0; font-size: 13px; vertical-alignment: center; x: 12px;
                                    }
                                    
                                    Text {
                                        text: "⌄"; color: #a1a6b8; font-size: 16px; vertical-alignment: center; x: parent.width - 24px; y: parent.height / 2 - 10px;
                                    }
                                    
                                    TouchArea {
                                        clicked => { encryption-popup.show(); }
                                    }
                                }
                            }
                            
                            VerticalLayout {
                                spacing: 6px;
                                Rectangle { height: 10px; }
                                Text {
                                    text: selected-language == "ru" ? "ЧЁРНЫЙ СПИСОК IP" : "IP BLOCKLIST";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 12px; height: 32px; alignment: start;
                                    TouchArea {
                                        clicked => { cfg-priv-blocklist-enabled = !cfg-priv-blocklist-enabled; }
                                        width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                        Rectangle {
                                            width: 14px; height: 14px; border-radius: 3px;
                                            background: cfg-priv-blocklist-enabled ? #3f72f6 : #13151c;
                                            border-width: 1px; border-color: cfg-priv-blocklist-enabled ? #3f72f6 : #383a54;
                                            if cfg-priv-blocklist-enabled : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        text: selected-language == "ru" ? "Включить чёрный список:" : "Enable blocklist:";
                                        color: #bfcade; font-size: 13px; vertical-alignment: center; width: 170px; wrap: word-wrap;
                                    }
                                    
                                    Rectangle {
                                        width: 150px; height: 32px; border-radius: 4px; opacity: cfg-priv-blocklist-enabled ? 1.0 : 0.3;
                                        background: #171825; border-width: 1px; border-color: #2c2d42;
                                        LineEdit {
                                            enabled: cfg-priv-blocklist-enabled;
                                            width: 100%; height: 100%;
                                            placeholder-text: selected-language == "ru" ? "URL списка" : "Blocklist URL";
                                            text <=> cfg-priv-blocklist-url;
                                        }
                                    }
                                }
                                
                                HorizontalLayout {
                                    padding-left: 26px;
                                    Text {
                                        text: selected-language == "ru" ? "В чёрном списке " + cfg-priv-blocklist-entries + " записей" : "Blocklist contains " + cfg-priv-blocklist-entries + " records";
                                        color: #555b70; font-size: 11px;
                                    }
                                }
                            }
                            
                            HorizontalLayout {
                                spacing: 12px; height: 24px;
                                TouchArea {
                                    clicked => { cfg-priv-blocklist-auto-update = !cfg-priv-blocklist-auto-update; }
                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                    Rectangle {
                                        width: 14px; height: 14px; border-radius: 3px;
                                        background: cfg-priv-blocklist-auto-update ? #3f72f6 : #13151c;
                                        border-width: 1px; border-color: cfg-priv-blocklist-auto-update ? #3f72f6 : #383a54;
                                        if cfg-priv-blocklist-auto-update : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text {
                                    text: selected-language == "ru" ? "Разрешить автоматическое обновление" : "Allow automatic updates";
                                    color: #bfcade; font-size: 13px; vertical-alignment: center;
                                }
                            }
                        }
                        
                        // 6. REMOTE CONTROL SERVICES
                        if settings-tab == 6: Rectangle {
                            // Layout background/wrapper
                            VerticalLayout {
                                padding: 24px; spacing: 18px; alignment: start;
                                
                                // Title & Simulated detection toggle
                                VerticalLayout {
                                    spacing: 6px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: selected-language == "ru" ? "ПРОФИЛИ ПОДКЛЮЧЕНИЙ" : "CONNECTION PROFILES";
                                            color: #5e637a; font-size: 10px; font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        
                                        // Config file found badge toggle (now read-only status)
                                        Rectangle {
                                            height: 20px; border-radius: 10px;
                                            background: is-local-config-detected ? #10b9811a : #4d516d1a;
                                            border-width: 1px; border-color: is-local-config-detected ? #10b9814d : #4d516d4d;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                Rectangle {
                                                    width: 5px; height: 5px; border-radius: 2.5px;
                                                    background: is-local-config-detected ? #10b981 : #8189a0;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                Text {
                                                    text: is-local-config-detected ? 
                                                          (selected-language == "ru" ? "КОНФИГ НАЙДЕН" : "CONFIG FILE FOUND") : 
                                                          (selected-language == "ru" ? "КОНФИГ НЕ НАЙДЕН" : "NO CONFIG FILE FOUND");
                                                    color: is-local-config-detected ? #10b981 : #8189a0;
                                                    font-size: 9px; font-weight: 700; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: #2a2b38; }
                                }

                                if !is-editing-profile : VerticalLayout {
                                    spacing: 14px;
                                    
                                    HorizontalLayout {
                                        alignment: end;
                                        Rectangle {
                                            width: 140px; height: 28px; border-radius: 4px;
                                            background: ta-add-profile.has-hover ? #323656 : #25283f;
                                            border-width: 1px;
                                            border-color: ta-add-profile.has-hover ? #3a3e63 : #303350;
                                            HorizontalLayout {
                                                alignment: center; spacing: 6px;
                                                Text { text: "+"; color: #3f72f6; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                Text {
                                                    text: selected-language == "ru" ? "Добавить" : "Add Connection";
                                                    color: ta-add-profile.has-hover ? #ffffff : #e4e7f2; font-size: 11px; font-weight: 600; vertical-alignment: center;
                                                }
                                            }
                                            ta-add-profile := TouchArea {
                                                clicked => {
                                                    edit-profile-name = "";
                                                    edit-profile-host = "";
                                                    edit-profile-port = 9091;
                                                    edit-profile-auth = false;
                                                    edit-profile-username = "admin";
                                                    edit-profile-password = "";
                                                    editing-id = 3;
                                                    is-editing-profile = true;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 6px; background: #0f1019; border-width: 1px; border-color: #2c2e47;
                                        VerticalLayout {
                                            padding: 1px;
                                            
                                            // Profile 0: Local Host
                                            if is-local-config-detected : Rectangle {
                                                height: 52px; background: local-host-active ? #1315254d : transparent;
                                                HorizontalLayout {
                                                    padding-left: 14px; padding-right: 14px;
                                                    
                                                    TouchArea {
                                                        width: 200px;
                                                        clicked => {
                                                            local-host-active = true;
                                                            p1-active = false;
                                                            p2-active = false;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 12px;
                                                            Rectangle {
                                                                width: 7px; height: 7px; border-radius: 3.5px;
                                                                background: local-host-active ? #10b981 : #4d516d;
                                                                y: (parent.height - self.height) / 2;
                                                            }
                                                            VerticalLayout {
                                                                alignment: center; spacing: 2px;
                                                                Text { text: "Local Host"; color: local-host-active ? #e4e7f2 : #8189a0; font-size: 12px; font-weight: 600; }
                                                                Text { text: "127.0.0.1:9091"; color: #5e637a; font-size: 10px; }
                                                            }
                                                        }
                                                    }
                                                    
                                                    VerticalLayout {
                                                        alignment: center;
                                                        HorizontalLayout {
                                                            alignment: end; spacing: 8px;
                                                            Rectangle {
                                                                width: 50px; height: 26px; border-radius: 4px;
                                                                background: ta-edit-lh.has-hover ? #252844 : #1a1c2e;
                                                                border-width: 1px; border-color: ta-edit-lh.has-hover ? #373a5a : #282a44;
                                                                Text { text: selected-language == "ru" ? "Ред." : "Edit"; color: ta-edit-lh.has-hover ? #e4e7f2 : #8189a0; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-edit-lh := TouchArea {
                                                                    clicked => {
                                                                        edit-profile-name = "Local Host";
                                                                        edit-profile-host = "127.0.0.1";
                                                                        edit-profile-port = 9091;
                                                                        edit-profile-auth = false;
                                                                        edit-profile-username = "admin";
                                                                        edit-profile-password = "";
                                                                        editing-id = 0;
                                                                        is-editing-profile = true;
                                                                    }
                                                                }
                                                            }
                                                            Rectangle {
                                                                width: 54px; height: 26px; border-radius: 4px;
                                                                background: ta-del-lh.has-hover ? #341b25 : #24161c;
                                                                border-width: 1px; border-color: ta-del-lh.has-hover ? #5a2434 : #421d28;
                                                                Text { text: selected-language == "ru" ? "Удал." : "Delete"; color: ta-del-lh.has-hover ? #ff6b6b : #ef4444; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-del-lh := TouchArea {
                                                                    clicked => {
                                                                        delete-target-id = 0;
                                                                        delete-target-name = "Local Host";
                                                                        delete-countdown-val = 5;
                                                                        show-delete-dialog = true;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            if is-local-config-detected && (has-profile-1 || has-profile-2) : Rectangle { height: 1px; background: #1e2030; }

                                            // Profile 1
                                            if has-profile-1 : Rectangle {
                                                height: 52px; background: p1-active ? #1315254d : transparent;
                                                HorizontalLayout {
                                                    padding-left: 14px; padding-right: 14px;
                                                    
                                                    TouchArea {
                                                        width: 200px;
                                                        clicked => {
                                                            p1-active = true;
                                                            local-host-active = false;
                                                            p2-active = false;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 12px;
                                                            Rectangle {
                                                                width: 7px; height: 7px; border-radius: 3.5px;
                                                                background: p1-active ? #10b981 : #4d516d;
                                                                y: (parent.height - self.height) / 2;
                                                            }
                                                            VerticalLayout {
                                                                alignment: center; spacing: 2px;
                                                                Text { text: p1-name; color: p1-active ? #e4e7f2 : #8189a0; font-size: 12px; font-weight: 600; }
                                                                Text { text: p1-host + ":" + p1-port; color: #5e637a; font-size: 10px; }
                                                            }
                                                        }
                                                    }
                                                    
                                                    VerticalLayout {
                                                        alignment: center;
                                                        HorizontalLayout {
                                                            alignment: end; spacing: 8px;
                                                            Rectangle {
                                                                width: 50px; height: 26px; border-radius: 4px;
                                                                background: ta-edit-p1.has-hover ? #252844 : #1a1c2e;
                                                                border-width: 1px; border-color: ta-edit-p1.has-hover ? #373a5a : #282a44;
                                                                Text { text: selected-language == "ru" ? "Ред." : "Edit"; color: ta-edit-p1.has-hover ? #e4e7f2 : #8189a0; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-edit-p1 := TouchArea {
                                                                    clicked => {
                                                                        edit-profile-name = p1-name;
                                                                        edit-profile-host = p1-host;
                                                                        edit-profile-port = p1-port;
                                                                        edit-profile-auth = p1-auth;
                                                                        edit-profile-username = p1-username;
                                                                        edit-profile-password = p1-password;
                                                                        editing-id = 1;
                                                                        is-editing-profile = true;
                                                                    }
                                                                }
                                                            }
                                                            Rectangle {
                                                                width: 54px; height: 26px; border-radius: 4px;
                                                                background: ta-del-p1.has-hover ? #341b25 : #24161c;
                                                                border-width: 1px; border-color: ta-del-p1.has-hover ? #5a2434 : #421d28;
                                                                Text { text: selected-language == "ru" ? "Удал." : "Delete"; color: ta-del-p1.has-hover ? #ff6b6b : #ef4444; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-del-p1 := TouchArea {
                                                                    clicked => {
                                                                        delete-target-id = 1;
                                                                        delete-target-name = p1-name;
                                                                        delete-countdown-val = 5;
                                                                        show-delete-dialog = true;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            if has-profile-1 && has-profile-2 : Rectangle { height: 1px; background: #1e2030; }

                                            // Profile 2
                                            if has-profile-2 : Rectangle {
                                                height: 52px; background: p2-active ? #1315254d : transparent;
                                                HorizontalLayout {
                                                    padding-left: 14px; padding-right: 14px;
                                                    
                                                    TouchArea {
                                                        width: 200px;
                                                        clicked => {
                                                            p2-active = true;
                                                            local-host-active = false;
                                                            p1-active = false;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 12px;
                                                            Rectangle {
                                                                width: 7px; height: 7px; border-radius: 3.5px;
                                                                background: p2-active ? #10b981 : #4d516d;
                                                                y: (parent.height - self.height) / 2;
                                                            }
                                                            VerticalLayout {
                                                                alignment: center; spacing: 2px;
                                                                Text { text: p2-name; color: p2-active ? #e4e7f2 : #8189a0; font-size: 12px; font-weight: 600; }
                                                                Text { text: p2-host + ":" + p2-port; color: #5e637a; font-size: 10px; }
                                                            }
                                                        }
                                                    }
                                                    
                                                    VerticalLayout {
                                                        alignment: center;
                                                        HorizontalLayout {
                                                            alignment: end; spacing: 8px;
                                                            Rectangle {
                                                                width: 50px; height: 26px; border-radius: 4px;
                                                                background: ta-edit-p2.has-hover ? #252844 : #1a1c2e;
                                                                border-width: 1px; border-color: ta-edit-p2.has-hover ? #373a5a : #282a44;
                                                                Text { text: selected-language == "ru" ? "Ред." : "Edit"; color: ta-edit-p2.has-hover ? #e4e7f2 : #8189a0; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-edit-p2 := TouchArea {
                                                                    clicked => {
                                                                        edit-profile-name = p2-name;
                                                                        edit-profile-host = p2-host;
                                                                        edit-profile-port = p2-port;
                                                                        edit-profile-auth = p2-auth;
                                                                        edit-profile-username = p2-username;
                                                                        edit-profile-password = p2-password;
                                                                        editing-id = 2;
                                                                        is-editing-profile = true;
                                                                    }
                                                                }
                                                            }
                                                            Rectangle {
                                                                width: 54px; height: 26px; border-radius: 4px;
                                                                background: ta-del-p2.has-hover ? #341b25 : #24161c;
                                                                border-width: 1px; border-color: ta-del-p2.has-hover ? #5a2434 : #421d28;
                                                                Text { text: selected-language == "ru" ? "Удал." : "Delete"; color: ta-del-p2.has-hover ? #ff6b6b : #ef4444; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                                ta-del-p2 := TouchArea {
                                                                    clicked => {
                                                                        delete-target-id = 2;
                                                                        delete-target-name = p2-name;
                                                                        delete-countdown-val = 5;
                                                                        show-delete-dialog = true;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            if !is-local-config-detected && !has-profile-1 && !has-profile-2 : Rectangle {
                                                height: 80px;
                                                Text {
                                                    text: selected-language == "ru" ? "Нет activeных профилей подключений." : "No connection profiles configured.";
                                                    color: #5e637a; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if is-editing-profile : VerticalLayout {
                                    spacing: 14px;
                                    
                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: selected-language == "ru" ? "Название профиля:" : "Profile name:"; color: #939cb0; font-size: 11px; font-weight: 500; }
                                        Rectangle {
                                            width: 240px; height: 32px; border-radius: 4px;
                                            background: #171825; border-width: 1px; border-color: #2c2d42;
                                            LineEdit {
                                                width: 100%; height: 100%;
                                                text <=> edit-profile-name;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 6px;
                                        Text { text: selected-language == "ru" ? "IP-адрес / Хост:" : "IP address / Host:"; color: #939cb0; font-size: 11px; font-weight: 500; }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 120px; height: 32px; border-radius: 4px;
                                                background: #171825; border-width: 1px; border-color: #2c2d42;
                                                LineEdit {
                                                    width: 100%; height: 100%;
                                                    text <=> edit-profile-host;
                                                }
                                            }
                                            Rectangle {
                                                width: 78px; height: 32px; border-radius: 4px;
                                                background: #171825; border-width: 1px; border-color: #2c2d42;
                                                LineEdit {
                                                    width: 100%; height: 100%;
                                                    text: "9091";
                                                    enabled: false;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px; height: 24px;
                                        TouchArea {
                                            clicked => { edit-profile-auth = !edit-profile-auth; }
                                            width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                            Rectangle {
                                                width: 14px; height: 14px; border-radius: 3px;
                                                background: edit-profile-auth ? #3f72f6 : #13151c;
                                                border-width: 1px; border-color: edit-profile-auth ? #3f72f6 : #383a54;
                                                if edit-profile-auth : Text { text: "✓"; color: #ffffff; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                        Text { text: selected-language == "ru" ? "Требовать аутентификацию (пароль)" : "Enforce authentication password"; color: #939cb0; font-size: 12px; vertical-alignment: center; }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px; width: 240px; opacity: edit-profile-auth ? 1.0 : 0.3;
                                        Rectangle {
                                            width: 120px; height: 32px; border-radius: 4px;
                                            background: #171825; border-width: 1px; border-color: #2c2d42;
                                            LineEdit {
                                                enabled: edit-profile-auth;
                                                width: 100%; height: 100%;
                                                placeholder-text: "Login";
                                                text <=> edit-profile-username;
                                            }
                                        }
                                        Rectangle {
                                            width: 120px; height: 32px; border-radius: 4px;
                                            background: #171825; border-width: 1px; border-color: #2c2d42;
                                            LineEdit {
                                                enabled: edit-profile-auth;
                                                width: 100%; height: 100%;
                                                placeholder-text: "Password";
                                                text <=> edit-profile-password;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        Rectangle {
                                            width: 90px; height: 32px; border-radius: 4px;
                                            background: (edit-profile-name != "" && edit-profile-host != "") ? #25283f : #1a1c28;
                                            border-width: 1px; border-color: (edit-profile-name != "" && edit-profile-host != "") ? #303350 : #2c2e42;
                                            Text { 
                                                text: selected-language == "ru" ? "Сохранить" : "Save"; 
                                                color: (edit-profile-name != "" && edit-profile-host != "") ? #e4e7f2 : #5e637a; 
                                                font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; 
                                            }
                                            TouchArea {
                                                enabled: edit-profile-name != "" && edit-profile-host != "";
                                                clicked => {
                                                    if (editing-id == 0) {
                                                        // Local Host
                                                    } else if (editing-id == 1) {
                                                        p1-name = edit-profile-name;
                                                        p1-host = edit-profile-host;
                                                        p1-auth = edit-profile-auth;
                                                        p1-username = edit-profile-username;
                                                        p1-password = edit-profile-password;
                                                    } else if (editing-id == 2) {
                                                        p2-name = edit-profile-name;
                                                        p2-host = edit-profile-host;
                                                        p2-auth = edit-profile-auth;
                                                        p2-username = edit-profile-username;
                                                        p2-password = edit-profile-password;
                                                    } else if (editing-id == 3) {
                                                        if (!has-profile-1) {
                                                            p1-name = edit-profile-name;
                                                            p1-host = edit-profile-host;
                                                            p1-auth = edit-profile-auth;
                                                            p1-username = edit-profile-username;
                                                            p1-password = edit-profile-password;
                                                            has-profile-1 = true;
                                                        } else {
                                                            p2-name = edit-profile-name;
                                                            p2-host = edit-profile-host;
                                                            p2-auth = edit-profile-auth;
                                                            p2-username = edit-profile-username;
                                                            p2-password = edit-profile-password;
                                                            has-profile-2 = true;
                                                        }
                                                    }
                                                    is-editing-profile = false;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 80px; height: 32px; border-radius: 4px;
                                            background: ta-cancel-edit.has-hover ? #25283f : #1b1c2a;
                                            border-width: 1px;
                                            border-color: ta-cancel-edit.has-hover ? #383a54 : #27293d;
                                            Text { text: selected-language == "ru" ? "Отмена" : "Cancel"; color: ta-cancel-edit.has-hover ? #e4e7f2 : #8189a0; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                            ta-cancel-edit := TouchArea {
                                                clicked => {
                                                    is-editing-profile = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Overlying mini-dialog sheet
                            if show-delete-dialog : Rectangle {
                                width: 100%; height: 100%;
                                background: #07080fbf;
                                
                                Rectangle {
                                    width: 250px; height: 180px;
                                    background: #121320; border-width: 1px; border-color: #ef444466;
                                    border-radius: 12px;
                                    drop-shadow-blur: 30px; drop-shadow-color: #000000b2;
                                    
                                    VerticalLayout {
                                        padding: 24px; spacing: 20px;
                                        
                                        HorizontalLayout {
                                            spacing: 16px; alignment: start;
                                            Rectangle {
                                                width: 40px; height: 40px; border-radius: 8px;
                                                background: #3a1b18; border-width: 1px; border-color: #ef44444d;
                                                Text { text: "⚠️"; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            VerticalLayout {
                                                spacing: 6px; alignment: center;
                                                Text {
                                                    text: selected-language == "ru" ? "Удалить профиль?" : "Delete Profile?";
                                                    color: #ffffff; font-size: 14px; font-weight: 700;
                                                }
                                                Text {
                                                    text: selected-language == "ru" ? 
                                                          "Вы уверены, что хотите навсегда удалить профиль \"" + delete-target-name + "\"?" : 
                                                          "Are you sure you want to permanently delete \"" + delete-target-name + "\"?";
                                                    color: #939cb0; font-size: 12px; wrap: word-wrap;
                                                }
                                            }
                                        }
                                        
                                        HorizontalLayout {
                                            spacing: 12px; alignment: end;
                                            
                                            Rectangle {
                                                width: 80px; height: 32px; border-radius: 4px;
                                                background: ta-cancel-del.has-hover ? #25283f : #1b1c2a;
                                                border-width: 1px; border-color: ta-cancel-del.has-hover ? #383a54 : #27293d;
                                                Text { text: selected-language == "ru" ? "Отмена" : "Cancel"; color: ta-cancel-del.has-hover ? #e4e7f2 : #8189a0; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                                ta-cancel-del := TouchArea { clicked => { show-delete-dialog = false; } }
                                            }
                                            
                                            Rectangle {
                                                width: 110px; height: 32px; border-radius: 4px;
                                                background: delete-countdown-val > 0 ? #252636 : (ta-confirm-del.has-hover ? #dc2626 : #ef4444); 
                                                border-width: 1px; border-color: delete-countdown-val > 0 ? #303248 : (ta-confirm-del.has-hover ? #dc2626 : #ef4444);
                                                
                                                Text {
                                                    text: delete-countdown-val > 0 ? 
                                                          (selected-language == "ru" ? "Удалить (" + delete-countdown-val + "с)" : "Delete (" + delete-countdown-val + "s)") : 
                                                          (selected-language == "ru" ? "Удалить" : "Delete");
                                                    color: delete-countdown-val > 0 ? #5e637e : #ffffff;
                                                    font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;
                                                }
                                                
                                                ta-confirm-del := TouchArea {
                                                    enabled: delete-countdown-val == 0;
                                                    clicked => {
                                                        if (delete-target-id == 0) {
                                                            is-local-config-detected = false;
                                                            local-host-active = false;
                                                            if (has-profile-1) { p1-active = true; }
                                                            else if (has-profile-2) { p2-active = true; }
                                                        } else if (delete-target-id == 1) {
                                                            has-profile-1 = false;
                                                            p1-active = false;
                                                            if (is-local-config-detected) { local-host-active = true; }
                                                            else if (has-profile-2) { p2-active = true; }
                                                        } else if (delete-target-id == 2) {
                                                            has-profile-2 = false;
                                                            p2-active = false;
                                                            if (is-local-config-detected) { local-host-active = true; }
                                                            else if (has-profile-1) { p1-active = true; }
                                                        }
                                                        show-delete-dialog = false;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // 7. INTERFACE CONFIGURATION
                        if settings-tab == 7: VerticalLayout {
                            padding: 24px; spacing: 20px; alignment: start;
                            
                            VerticalLayout {
                                spacing: 18px; alignment: start;
                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: selected-language == "ru" ? "ЯЗЫК ИНТЕРФЕЙСА" : "INTERFACE LANGUAGE";
                                        color: #5e637a; font-size: 10px; font-weight: 700;
                                    }
                                    Rectangle { height: 1px; background: #2a2b38; }
                                }
                                
                                Rectangle {
                                    width: 240px; height: 38px; border-radius: 8px;
                                    background: #0f1019; border-width: 1px; border-color: #2c2e47;
                                    
                                    lang-popup := PopupWindow {
                                        x: 0; y: 40px; width: 240px; height: 198px;
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: #12131d; border-radius: 8px; border-width: 1px; border-color: #2b2d42;
                                            
                                            VerticalLayout {
                                                padding: 4px; spacing: 4px;
                                                for lang-item in [
                                                    {code: "en", label: "English"},
                                                    {code: "de", label: "Deutsch"},
                                                    {code: "ru", label: "Русский"},
                                                    {code: "zh", label: "中文"},
                                                    {code: "es", label: "Español"},
                                                ]: Rectangle {
                                                    height: 34px; border-radius: 6px;
                                                    background: selected-language == lang-item.code ? #1b2a47 : ta-item.has-hover ? #171825 : transparent;
                                                    ta-item := TouchArea {
                                                        clicked => {
                                                            selected-language = lang-item.code;
                                                            language-changed(lang-item.code);
                                                            lang-popup.close();
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 12px; padding-right: 12px;
                                                        Text {
                                                            text: lang-item.label;
                                                            color: selected-language == lang-item.code ? #e4e7f2 : #8189a0;
                                                            font-size: 12px; vertical-alignment: center;
                                                        }
                                                        if selected-language == lang-item.code : Text {
                                                            text: "✓"; color: #3f72f6; font-size: 12px; font-weight: 700;
                                                            vertical-alignment: center; horizontal-alignment: right;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px;
                                        Text {
                                            text: selected-language == "en" ? "English" :
                                                  selected-language == "de" ? "Deutsch" :
                                                  selected-language == "ru" ? "Русский" :
                                                  selected-language == "zh" ? "中文" : "Español";
                                            color: #e4e7f2; font-size: 12px; vertical-alignment: center;
                                        }
                                        Text {
                                            text: "⌄"; color: #8189a0; font-size: 16px; vertical-alignment: center; horizontal-alignment: right;
                                        }
                                    }
                                    
                                    TouchArea {
                                        clicked => { lang-popup.show(); }
                                    }
                                }
                                
                                Text {
                                    text: selected-language == "ru" ? "* Для полной смены локали может потребоваться перезапуск программы" : "* Dynamic elements will require standard client reload to change fully";
                                    color: #5e637a; font-size: 10px; font-italic: true;
                                }
                            }
                            
                            Rectangle { height: 10px; } // spacer
                            
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: selected-language == "ru" ? "ОБЩИЙ ВИД" : "GENERAL VISUAL SETTINGS";
                                    color: #5e637a; font-size: 10px; font-weight: 700;
                                }
                                Rectangle { height: 1px; background: #2a2b38; }
                            }
                            
                            HorizontalLayout {
                                spacing: 20px; height: 32px;
                                Text {
                                    text: selected-language == "ru" ? "Обновление списка раздач:" : "GUI list update frequency:";
                                    color: #939cb0; font-size: 12px; vertical-alignment: center; width: 170px;
                                }
                                Rectangle {
                                    width: 180px; height: 32px; border-radius: 4px;
                                    background: #171825; border-width: 1px; border-color: #2c2d42;
                                    Text {
                                        text: cfg-refresh-interval + " s";
                                        color: #e2e8f0; font-size: 12px; vertical-alignment: center; x: 12px;
                                    }
                                }
                            }
                        }
                        
                        // 8. ABOUT PROGRAM
                        if settings-tab == 8: VerticalLayout {
                            padding-top: 16px; padding-bottom: 16px; spacing: 14px; alignment: center;
                            
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 64px; height: 64px; border-radius: 16px;
                                    background: #171825; border-width: 1px; border-color: #282a41;
                                    Image {
                                        source: @image-url("assets/images/app_logo_1779530528978.png");
                                        width: 48px;
                                        height: 48px;
                                    }
                                }
                            }
                            
                            Text {
                                text: "Transmission Remote Slint";
                                color: #e4e7f2; font-size: 16px; font-weight: 700;
                                horizontal-alignment: center;
                            }
                            
                            Text {
                                text: "v0.4.0 — Rust + Slint 1.7";
                                color: #5e637a; font-size: 11px;
                                horizontal-alignment: center;
                            }
                            
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: selected-language == "ru" ? "Лёгкий нативный GUI для Transmission daemon.\nБез GTK, без Qt — рендеринг через Skia/OpenGL и Vulkan." :
                                                                      "Lightweight native GUI for Transmission daemon.\nNo GTK, no Qt — rendering via Skia/OpenGL and Vulkan.";
                                    color: #939cb0; font-size: 11px;
                                    horizontal-alignment: center; wrap: word-wrap;
                                    width: 250px;
                                }
                            }
                            
                            // Beautiful interactive-like github card
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 250px; height: 48px; border-radius: 8px;
                                    background: ta-github-about.has-hover ? #1e1f31 : #171825;
                                    border-width: 1px; border-color: ta-github-about.has-hover ? #383a54 : #232435;
                                    
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                                        alignment: center;
                                        
                                        Image {
                                            source: @image-url("assets/images/github.svg");
                                            width: 16px;
                                            height: 16px;
                                            colorize: #8189a0;
                                        }
                                        
                                        VerticalLayout {
                                            alignment: center;
                                            Text { text: "guglovich/Transmission-Remote-Slint"; color: #e4e7f2; font-size: 11px; font-weight: 600; }
                                            Text { text: "github.com"; color: #5e637a; font-size: 9px; }
                                        }
                                        
                                        Rectangle { } // spacer
                                        
                                        Text { text: "↗"; color: #5e637a; font-size: 14px; vertical-alignment: center; }
                                    }
                                    
                                    ta-github-about := TouchArea {}
                                }
                            }
                            
                            // Styled Separator
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 250px; height: 1px; background: #181926;
                                }
                            }
                            
                            // Key-Value grid representation
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    width: 250px; spacing: 8px;
                                    
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "Лицензия" : "License"; color: #5e637a; font-size: 11px; }
                                        Text { text: "GPL-2.0-or-later"; color: #939cb0; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "Язык" : "Language"; color: #5e637a; font-size: 11px; }
                                        Text { text: "Rust 2021 edition"; color: #939cb0; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "UI-фреймворк" : "UI-Framework"; color: #5e637a; font-size: 11px; }
                                        Text { text: "Slint 1.7 (GPLv3)"; color: #939cb0; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "Рендерер" : "Renderer"; color: #5e637a; font-size: 11px; }
                                        Text { text: "Skia / OpenGL / Vulkan"; color: #939cb0; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "Трей" : "Tray"; color: #5e637a; font-size: 11px; }
                                        Text { text: "zbus 4 (SNI/D-Bus)"; color: #939cb0; font-size: 11px; }
                                    }
                                    HorizontalLayout {
                                        Text { width: 90px; text: selected-language == "ru" ? "Разработано с" : "Developed with"; color: #5e637a; font-size: 11px; }
                                        Text { text: "Claude (Anthropic)"; color: #939cb0; font-size: 11px; }
                                    }
                                }
                            }
                        }
                        
                        // spacer for bottom scroll
                        Rectangle { height: 16px; }
                        }
                    }
                }
                
            }
            
            Rectangle { height: 1px; background: #2a2b38; }
        }

        // Close button — закреплён в правом верхнем углу (поверх layout'а)
        Rectangle {
            x: parent.width - self.width - 7px;
            y: 7px;
            width: 30px; height: 30px;
            border-radius: 7px;
            background: close-x-ta.has-hover ? #2a2d42 : transparent;
            border-width: 1px;
            border-color: close-x-ta.has-hover ? #3a3e5a : transparent;
            animate background { duration: 120ms; }
            animate border-color { duration: 120ms; }
            close-x-ta := TouchArea {
                clicked => { cancelled(); }
                mouse-cursor: pointer;
            }
            Text {
                text: "✕"; font-size: 15px; font-weight: 600;
                color: close-x-ta.has-hover ? #e4e7f2 : #64748b;
                animate color { duration: 120ms; }
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

component TorrentRow inherits Rectangle {
    in property <TorrentItem> item;
    in property <bool>        is-even;
    in property <bool>        is-selected;
    in property <int>         row-index;
    in property <length>      col-name-w:   290px;
    in property <length>      col-status-w: 100px;
    in property <length>      col-done-w:    54px;
    in property <length>      col-down-w:    80px;
    callback request-context-menu(int, string, string, bool, int, int, int);

    height: 50px;
    background: is-selected ? #2a3a50 : (is-even ? #161c27 : #1a2233);

    ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                request-context-menu(
                    item.id, item.name, item.download-dir, item.is-paused,
                    (self.absolute-position.x + self.mouse-x) / 1px,
                    (self.absolute-position.y + self.mouse-y) / 1px,
                    row-index
                );
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 6px; alignment: stretch;
        VerticalLayout {
            width: col-name-w; alignment: center; spacing: 3px;
            Text { text: item.name; color: #d0d8ec; font-size: 13px; overflow: elide; }
            if item.is-error && item.error-string != "" : Text { text: item.error-string; color: #c06050; font-size: 10px; overflow: elide; }
            if !item.is-error : ProgressIndicator { progress: item.progress; height: 5px; }
        }
        Rectangle { width: 9px; }
        Text {
            width: col-status-w;
            text: item.is-checking ? (item.status-label + " " + Math.round(item.progress * 100) + "%") : item.status-label;
            color: item.is-error ? #c04040 : item.is-paused ? #556070 : item.is-checking ? #a07830 : #38b865;
            font-size: 12px; vertical-alignment: center;
        }
        Rectangle { width: 9px; }
        Text {
            width: col-done-w; text: item.is-checking ? "" : Math.round(item.progress * 100) + "%";
            color: #687888; font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle { width: 9px; }
        Text { width: col-down-w; text: "↓ " + item.down-speed; color: #4a9ed8; font-size: 12px; vertical-alignment: center; }
        Rectangle { width: 9px; }
        Text { horizontal-stretch: 1; text: "↑ " + item.up-speed; color: #c87e28; font-size: 12px; vertical-alignment: center; }
    }
}

component StatsBar inherits HorizontalLayout {
    in property <SessionStats> stats;
    in-out property <bool> speed-in-bits: false;
    in-out property <bool> traffic-in-tb: false;
    callback toggle-speed-units();
    callback toggle-traffic-units();
    spacing: 0px; alignment: end;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        Text { text: stats.active + " active"; color: #406858; font-size: 11px; vertical-alignment: center; }
    }
    Rectangle { width: 1px; height: parent.height; background: #202e48; }
    Rectangle {
        background: speed-ta.has-hover ? #141e2e : transparent;
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 10px;
            Text { text: "↓ " + (stats.down-speed != "" ? stats.down-speed : "—"); color: #2a6898; font-size: 11px; vertical-alignment: center; }
            Text { text: "↑ " + (stats.up-speed != "" ? stats.up-speed : "—"); color: #885818; font-size: 11px; vertical-alignment: center; }
        }
        speed-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                speed-in-bits = !speed-in-bits;
                root.toggle-speed-units();
            }
        }
    }
    Rectangle { width: 1px; height: parent.height; background: #202e48; }
    Rectangle {
        background: traffic-ta.has-hover ? #141e2e : transparent;
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 10px;
            Text { text: "⬇ " + (stats.downloaded != "" ? stats.downloaded : "0 B"); color: #385868; font-size: 11px; vertical-alignment: center; }
            Text { text: "⬆ " + (stats.uploaded != "" ? stats.uploaded : "0 B"); color: #785030; font-size: 11px; vertical-alignment: center; }
        }
        traffic-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                traffic-in-tb = !traffic-in-tb;
                root.toggle-traffic-units();
            }
        }
    }
    Rectangle { width: 1px; height: parent.height; background: #202e48; }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px;
        Text { text: "R " + (stats.ratio != "" ? stats.ratio : "0.00"); color: #506838; font-size: 11px; vertical-alignment: center; }
    }
}

export component MainWindow inherits Window {
    title: "Transmission Remote";
    background: #111722;
    min-width: 740px; min-height: 460px;
    preferred-width: 1060px; preferred-height: 700px;

    in property <[TorrentItem]> torrents;
    in property <SessionStats>  stats;
    in property <string>  status-bar-text: "Starting…";
    in property <bool>    connected: false;
    in property <[DiskItem]> disk-groups;
    in-out property <int> selected-disk: -1;

    in-out property <int> count-all: 0;
    in-out property <int> count-downloading: 0;
    in-out property <int> count-seeding: 0;
    in-out property <int> count-completed: 0;
    in-out property <int> count-stopped: 0;
    in-out property <int> count-active: 0;
    in-out property <int> count-error: 0;
    in-out property <string> active-filter: "all";

    in-out property <bool> speed-in-bits: false;
    in-out property <bool> traffic-in-tb: false;
    callback toggle-speed-units();
    callback toggle-traffic-units();

    in-out property <length> col-name-w:   290px;
    in-out property <length> col-status-w: 100px;
    in-out property <length> col-done-w:    54px;
    in-out property <length> col-down-w:    80px;

    in-out property <string> sort-col: "";
    in-out property <bool>   sort-asc: false;
    callback sort-changed(string, bool);

    in-out property <string>   rpc-url: "localhost";
    in-out property <[string]> rpc-candidates: ["localhost:9091", "seedbox:9091"];
    in-out property <bool>     rpc-popup-visible: false;
    in-out property <bool>     is-switching-host: false;
    in-out property <string>   switching-host-name: "";
    callback switch-rpc(string);

    in-out property <bool>   dialog-visible: false;
