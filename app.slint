    in-out property <string> cfg-remote-whitelist: "";
    in-out property <bool>   cfg-autostart: false;
    in-out property <bool>   cfg-suspend: false;
    in-out property <bool>   cfg-start-minimized: false;
    in-out property <bool>   cfg-delete-torrent: false;
    in-out property <int>     cfg-refresh-interval: 5;
    in-out property <int>     cfg-on-close: 0;
    in-out property <bool>   cfg-notify-add: true;
    in-out property <bool>   cfg-notify-complete: true;
    in-out property <bool>   cfg-notify-sound: true;
    in-out property <int>     cfg-theme: 0;
    in-out property <bool>   cfg-tb-add: true;
    in-out property <bool>   cfg-tb-magnet: true;
    in-out property <bool>   cfg-tb-create: true;
    in-out property <bool>   cfg-tb-rehash: true;
    in-out property <bool>   cfg-tb-start-sel: true;
    in-out property <bool>   cfg-tb-pause-sel: true;
    in-out property <bool>   cfg-tb-start-all: true;
    in-out property <bool>   cfg-tb-pause-all: true;
    in-out property <bool>   cfg-lp-status: true;
    in-out property <bool>   cfg-lp-disks: true;
    in-out property <bool>   cfg-lp-trackers: false;
    in-out property <bool>   cfg-lp-webtorrents: false;
    in-out property <bool>   cfg-lp-tags: false;
    in-out property <bool>   cfg-lp-created: false;

    in-out property <bool>   context-menu-visible: false;
    in-out property <int>    context-menu-target-id: -1;
    in-out property <int>    context-menu-target-index: -1;
    in-out property <string> context-menu-torrent-name: "";
    in-out property <string> context-menu-torrent-dir: "";
    in-out property <bool>   context-menu-target-paused: false;
    in-out property <int>    context-menu-x: 0;
    in-out property <int>    context-menu-y: 0;
    in-out property <int>    selected-index: -1;

    in-out property <bool>   set-location-dialog-visible: false;
    in-out property <int>    set-location-torrent-id: -1;
    in-out property <string> set-location-torrent-name: "";
    in-out property <string> set-location-path: "";
    in-out property <bool>   set-location-do-move: true;

    in-out property <string> search-text: "";

    in property <string> tr-toolbar-open: "Open";
    in property <string> tr-toolbar-magnet: "Magnet";
    in property <string> tr-toolbar-create: "Create";
    in property <string> tr-toolbar-rehash: "Rehash";
    in property <string> tr-sidebar-status: "Status";
    in property <string> tr-sidebar-all: "All";
    in property <string> tr-sidebar-downloading: "Downloading";
    in property <string> tr-sidebar-seeding: "Seeding";
    in property <string> tr-sidebar-completed: "Completed";
    in property <string> tr-sidebar-stopped: "Stopped";
    in property <string> tr-sidebar-active: "Active";
    in property <string> tr-sidebar-inactive: "Inactive";
    in property <string> tr-sidebar-checking: "Checking";
    in property <string> tr-sidebar-error: "Error";
    in property <string> tr-sidebar-disks: "Disks";
    in property <string> tr-column-name: "Name";
    in property <string> tr-column-status: "Status";
    in property <string> tr-column-done: "Done";
    in property <string> tr-column-down: "Down";
    in property <string> tr-column-up: "Up";
    in property <string> tr-menu-start: "Start";
    in property <string> tr-menu-pause: "Pause";
    in property <string> tr-menu-recheck: "Recheck";
    in property <string> tr-menu-open-folder: "Open Folder";
    in property <string> tr-menu-set-location: "Set Location";
    in property <string> tr-menu-remove: "Remove Torrent";
    in property <string> tr-menu-delete: "Delete Torrent + Files";
    in property <string> tr-statusbar-dht:  "DHT";
    in property <string> tr-statusbar-conn: "conn";

    callback search-changed(string);
    callback rehash-errors();
    callback filter-clicked(string);
    callback magnet-submitted(string);
    callback language-changed(string);
    callback saved();
    callback settings-open();
    callback pick-dl-script-path();
    callback pick-seed-script-path();
    callback start-torrent(int);
    callback stop-torrent(int);
    callback start-all();
    callback stop-all();
    callback remove-torrent(int, bool);
    callback recheck-torrent(int);
    callback open-folder(string);
    callback request-set-location(int, string, string);
    callback set-location(int, string, bool);
    callback set-location-cmd(int, string, bool);
    callback set-location-xdg-dialog(int, string, string, bool);
    callback pick-context-menu-set-location(int, string, string);
    callback get-last-location() -> string;
    callback click-outside();
    callback add-torrent-url(string);
    callback pick-torrent-file();
    callback create-torrent(string, string);
    callback pick-create-path();
    callback do-minimize-tray();
    callback do-quit();
    callback stop-disk-torrents(int);
    callback start-disk-torrents(int);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 42px; background: #0d1420;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 2px; alignment: start;
                Rectangle {
                    width: selected-language == "ru" ? 94px : 84px; height: 28px; y: 7px;
                    background: btn-open.has-hover ? #21253a : transparent; border-radius: 5px;
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Image {
                            source: @image-url("assets/images/toolbar-open.svg");
                            width: 13px; height: 13px;
                            colorize: btn-open.has-hover ? #e4e7f2 : #8f97b8;
                        }
                        Text {
                            text: tr-toolbar-open;
                            color: btn-open.has-hover ? #e4e7f2 : #8f97b8;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    btn-open := TouchArea { clicked => { pick-torrent-file(); } }
                }
                Rectangle {
                    width: 86px; height: 28px; y: 7px;
                    background: btn-magnet.has-hover ? #21253a : transparent; border-radius: 5px;
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Image {
                            source: @image-url("assets/images/toolbar-magnet.svg");
                            width: 13px; height: 13px;
                            colorize: btn-magnet.has-hover ? #e4e7f2 : #8f97b8;
                        }
                        Text {
                            text: tr-toolbar-magnet;
                            color: btn-magnet.has-hover ? #e4e7f2 : #8f97b8;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    btn-magnet := TouchArea { clicked => { magnet-dialog-visible = true; } }
                }
                Rectangle {
                    width: selected-language == "ru" ? 92px : 84px; height: 28px; y: 7px;
                    background: btn-create.has-hover ? #21253a : transparent; border-radius: 5px;
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Image {
                            source: @image-url("assets/images/toolbar-create.svg");
                            width: 13px; height: 13px;
                            colorize: btn-create.has-hover ? #e4e7f2 : #8f97b8;
                        }
                        Text {
                            text: tr-toolbar-create;
                            color: btn-create.has-hover ? #e4e7f2 : #8f97b8;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    btn-create := TouchArea { clicked => { create-dialog-visible = true; } }
                }
                Rectangle {
                    width: 88px; height: 28px; y: 7px;
                    background: count-error > 0 ? (btn-rehash.has-hover ? #2a1e10 : #1a1208) : (btn-rehash.has-hover ? #21253a : transparent);
                    border-radius: 5px;
                    border-width: count-error > 0 ? 1px : 0px;
                    border-color: count-error > 0 ? (btn-rehash.has-hover ? #e8a050 : #e8a05066) : transparent;
                    HorizontalLayout {
                        alignment: center; spacing: 6px;
                        Image {
                            source: @image-url("assets/images/toolbar-rehash.svg");
                            width: 13px; height: 13px;
                            colorize: count-error > 0 ? (btn-rehash.has-hover ? #ffb86c : #e8a050) : (btn-rehash.has-hover ? #e4e7f2 : #3a4258);
                        }
                        Text {
                            text: tr-toolbar-rehash;
                            color: count-error > 0 ? (btn-rehash.has-hover ? #ffb86c : #e8a050) : (btn-rehash.has-hover ? #e4e7f2 : #3a4258);
                            font-size: 12px;
                            font-weight: count-error > 0 ? 600 : 500;
                            vertical-alignment: center;
                        }
                    }
                    btn-rehash := TouchArea { clicked => { if (count-error > 0) { rehash-errors(); } } }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 320px; height: 28px; y: 7px; background: #0a1018; border-radius: 6px; border-width: 1px; border-color: #1e2e42;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 8px; spacing: 6px;
                        Text { text: "🔍"; font-size: 13px; color: #506070; vertical-alignment: center; }
                        search-input := TextInput {
                            horizontal-stretch: 1; font-size: 13px; color: #c8d8ec; vertical-alignment: center; text <=> search-text;
                            edited => { search-changed(self.text); }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 50px; height: 28px; y: 7px; background: btn-settings.has-hover ? #21253a : transparent; border-radius: 5px;
                    btn-settings := TouchArea { clicked => { settings-open(); settings-dialog-visible = true; } }
                    Text { text: selected-language == "en" ? "EN" : selected-language == "de" ? "DE" : selected-language == "ru" ? "RU" : selected-language == "zh" ? "ZH" : selected-language == "es" ? "ES" : "EN"; color: #90c8f0; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        HorizontalLayout {
            spacing: 0px; vertical-stretch: 1;
            Rectangle {
                width: 200px; background: #0d1420; border-width: 1px; border-color: #202e48;
                ScrollView {
                    VerticalLayout {
                        padding: 4px; spacing: 2px;
                        Rectangle { height: 24px; Text { text: tr-sidebar-status; color: #506070; font-size: 11px; font-weight: 600; x: 8px; } }
                        for tab-item in [
                            { filter: "all", label: tr-sidebar-all, count: count-all, bg: #38c058 },
                            { filter: "active", label: tr-sidebar-active, count: count-active, bg: #4a7cf7 },
                            { filter: "downloading", label: tr-sidebar-downloading, count: count-downloading, bg: #4a7cf7 },
                            { filter: "seeding", label: tr-sidebar-seeding, count: count-seeding, bg: #3db87a },
                            { filter: "stopped", label: tr-sidebar-stopped, count: count-stopped, bg: #8f97b8 },
                            { filter: "error", label: tr-sidebar-error, count: count-error, bg: #e05555 },
                            { filter: "completed", label: tr-sidebar-completed, count: count-completed, bg: #3db87a }
                        ]: Rectangle {
                            height: 26px; background: active-filter == tab-item.filter ? #21253a : transparent; border-radius: 4px;
                            TouchArea { clicked => { active-filter = tab-item.filter; filter-clicked(tab-item.filter); } }
                            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: tab-item.bg; x: 8px; y: (parent.height - self.height)/2; }
                            Text { text: tab-item.label; color: active-filter == tab-item.filter ? #e4e7f2 : #8f97b8; font-size: 12px; x: 24px; y: (parent.height - self.height)/2; }
                            Rectangle {
                                width: 44px; height: 18px; background: active-filter == tab-item.filter ? #282d42 : #1a1d27; border-radius: 3px; x: parent.width - 52px; y: (parent.height - self.height)/2;
                                Text { text: tab-item.count + ""; color: active-filter == tab-item.filter ? #90c8f0 : #4e556e; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        // Separator under the State ("Состояние") block
                        Rectangle { height: 4px; }
                        Rectangle { height: 1px; background: #202e48; }
                        Rectangle { height: 4px; }

                        // Disks section if available
                        if disk-groups.length > 0 : VerticalLayout {
                            spacing: 2px;
                            Rectangle { height: 24px; Text { text: tr-sidebar-disks; color: #506070; font-size: 11px; font-weight: 600; x: 8px; } }
                            for disk[idx] in disk-groups: Rectangle {
                                height: 26px; background: selected-disk == idx ? #21253a : transparent; border-radius: 4px;
                                TouchArea { clicked => { selected-disk = selected-disk == idx ? -1 : idx; } }
                                Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #4a7cf7; x: 8px; y: (parent.height - self.height)/2; }
                                Text { text: disk.label; color: selected-disk == idx ? #e4e7f2 : #8f97b8; font-size: 12px; x: 24px; y: (parent.height - self.height)/2; }
                                Rectangle {
                                    width: 44px; height: 18px; background: selected-disk == idx ? #282d42 : #1a1d27; border-radius: 3px; x: parent.width - 52px; y: (parent.height - self.height)/2;
                                    Text { text: disk.torrent-count + ""; color: selected-disk == idx ? #90c8f0 : #4e556e; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 4px; }
                            Rectangle { height: 1px; background: #202e48; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 0px; horizontal-stretch: 1;
                Rectangle {
                    height: 24px; background: #0b1420; border-width: 1px; border-color: #1a2535;
                    property <length> avail: self.width - 54px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 6px; spacing: 0px;
                        Text { width: col-name-w; text: tr-column-name; color: #4a5870; font-size: 11px; vertical-alignment: center; }
                        Rectangle {
                            width: 9px;
                            property <length> drag-start-x; property <length> drag-start-w;
                            Rectangle { width: 1px; height: parent.height; x: 4px; background: sep-ns.has-hover ? #3a5070 : #1e2a3a; }
                            sep-ns := TouchArea {
                                pointer-event(e) => { if (e.kind == PointerEventKind.down) { drag-start-x = self.absolute-position.x + self.mouse-x; drag-start-w = col-name-w; } }
                                moved => { col-name-w = Math.clamp(drag-start-w + (self.absolute-position.x + self.mouse-x - drag-start-x), 40px, avail - col-status-w - col-done-w - col-down-w - 40px); }
                            }
                        }
                        Text { width: col-status-w; text: tr-column-status; color: #4a5870; font-size: 11px; vertical-alignment: center; }
                        Rectangle {
                            width: 9px;
                            property <length> drag-start-x; property <length> drag-start-w;
                            Rectangle { width: 1px; height: parent.height; x: 4px; background: sep-sd.has-hover ? #3a5070 : #1e2a3a; }
                            sep-sd := TouchArea {
                                pointer-event(e) => { if (e.kind == PointerEventKind.down) { drag-start-x = self.absolute-position.x + self.mouse-x; drag-start-w = col-status-w; } }
                                moved => { col-status-w = Math.clamp(drag-start-w + (self.absolute-position.x + self.mouse-x - drag-start-x), 40px, avail - col-name-w - col-done-w - col-down-w - 40px); }
                            }
                        }
                        Rectangle {
                            width: col-done-w;
                            TouchArea { clicked => { if (sort-col == "done") { sort-asc = !sort-asc; } else { sort-col = "done"; sort-asc = true; } sort-changed(sort-col, sort-asc); } }
                            Text { text: tr-column-done + (sort-col == "done" ? (sort-asc ? " ↑" : " ↓") : ""); color: #4a5870; font-size: 11px; }
                        }
                        Rectangle {
                            width: 9px;
                            property <length> drag-start-x; property <length> drag-start-w;
                            Rectangle { width: 1px; height: parent.height; x: 4px; background: sep-dd.has-hover ? #3a5070 : #1e2a3a; }
                            sep-dd := TouchArea {
                                pointer-event(e) => { if (e.kind == PointerEventKind.down) { drag-start-x = self.absolute-position.x + self.mouse-x; drag-start-w = col-done-w; } }
                                moved => { col-done-w = Math.clamp(drag-start-w + (self.absolute-position.x + self.mouse-x - drag-start-x), 30px, avail - col-name-w - col-status-w - col-down-w - 40px); }
                            }
                        }
                        Rectangle {
                            width: col-down-w;
                            TouchArea { clicked => { if (sort-col == "down") { sort-asc = !sort-asc; } else { sort-col = "down"; sort-asc = false; } sort-changed(sort-col, sort-asc); } }
                            Text { text: tr-column-down + (sort-col == "down" ? (sort-asc ? " ↑" : " ↓") : ""); color: #4a5870; font-size: 11px; }
                        }
                        Rectangle {
                            width: 9px;
                            property <length> drag-start-x; property <length> drag-start-w;
                            Rectangle { width: 1px; height: parent.height; x: 4px; background: sep-du.has-hover ? #3a5070 : #1e2a3a; }
                            sep-du := TouchArea {
                                pointer-event(e) => { if (e.kind == PointerEventKind.down) { drag-start-x = self.absolute-position.x + self.mouse-x; drag-start-w = col-down-w; } }
                                moved => { col-down-w = Math.clamp(drag-start-w + (self.absolute-position.x + self.mouse-x - drag-start-x), 40px, avail - col-name-w - col-status-w - col-done-w - 40px); }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            TouchArea { clicked => { if (sort-col == "up") { sort-asc = !sort-asc; } else { sort-col = "up"; sort-asc = false; } sort-changed(sort-col, sort-asc); } }
                            Text { text: tr-column-up + (sort-col == "up" ? (sort-asc ? " ↑" : " ↓") : ""); color: #4a5870; font-size: 11px; }
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for item[idx] in torrents : TorrentRow {
                        item: item; is-even: Math.mod(idx, 2) == 0; is-selected: idx == selected-index; row-index: idx;
                        col-name-w: col-name-w; col-status-w: col-status-w; col-done-w: col-done-w; col-down-w: col-down-w;
                        request-context-menu(id, tname, tdir, is-paused, pos-x, pos-y, p-idx) => {
                            selected-index = p-idx; context-menu-visible = true; context-menu-target-id = id; context-menu-target-index = p-idx;
                            context-menu-torrent-name = tname; context-menu-torrent-dir = tdir; context-menu-target-paused = is-paused;
                            context-menu-x = pos-x; context-menu-y = pos-y;
                        }
                    }
                }
                if torrents.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text { text: connected ? "No torrents found in this filter state." : "Waiting for interface backend connection…"; color: #3b4c64; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Rectangle {
            height: 26px; background: #09101a;
            Rectangle { width: 100%; height: 1px; background: #202e48; y: 0px; }
            HorizontalLayout {
                padding-left: 0px; padding-right: 0px; spacing: 0px;
                Rectangle {
                    width: 200px; background: ip-ta.has-hover || rpc-popup-visible ? #141e2e : transparent;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 6px;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: connected ? #2a9a50 : #8a3030; y: (parent.height - self.height)/2; }
                        Text { text: rpc-url; color: ip-ta.has-hover || rpc-popup-visible ? #90b8d8 : #4a6070; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: rpc-popup-visible ? "▴" : "▾"; color: ip-ta.has-hover || rpc-popup-visible ? #90b8d8 : #4a6070; font-size: 10px; vertical-alignment: center; }
                    }
                    ip-ta := TouchArea { clicked => { rpc-popup-visible = !rpc-popup-visible; } }
                }
                Rectangle { width: 1px; height: parent.height; background: #202e48; }
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text { text: tr-statusbar-dht + " " + stats.dht; color: #3a5060; font-size: 11px; vertical-alignment: center; }
                }
                Rectangle { width: 1px; height: parent.height; background: #202e48; }
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text { text: stats.peers + " " + tr-statusbar-conn; color: #3a5060; font-size: 11px; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                StatsBar {
                    stats: stats;
                    speed-in-bits <=> root.speed-in-bits;
                    traffic-in-tb <=> root.traffic-in-tb;
                    toggle-speed-units => { root.toggle-speed-units(); }
                    toggle-traffic-units => { root.toggle-traffic-units(); }
                }
            }
        }
    }

    if rpc-popup-visible: Rectangle {
        width: 100%; height: 100%; z: 300;
        TouchArea { clicked => { rpc-popup-visible = false; } }
        Rectangle {
            x: 0px; y: parent.height - self.height - 26px; width: 170px;
            height: rpc-candidates.length * 28px + 8px;
            background: #141b26; border-radius: 4px; border-width: 1px; border-color: #2c3c54;
            VerticalLayout {
                padding: 4px; spacing: 0px;
                for url in rpc-candidates: Rectangle {
                    height: 28px; border-radius: 3px;
                    background: row-ta.has-hover ? #1f2b3e : (url == rpc-url ? #18283c : transparent);
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 6px;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            background: url == rpc-url ? (connected ? #2a9a50 : #3db87a) : #405060;
                            y: (parent.height - self.height)/2;
                        }
                        Text {
                            text: url;
                            color: url == rpc-url ? #e0ecf8 : (row-ta.has-hover ? #d0dce8 : #8098b0);
                            font-size: 11px;
                            font-weight: url == rpc-url ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if url == rpc-url : Text {
                            text: "✓";
                            color: #3db87a;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    row-ta := TouchArea {
                        clicked => {
                            rpc-popup-visible = false;
                            rpc-url = url;
                            is-switching-host = true;
                            switching-host-name = url;
                            switch-rpc(url);
                        }
                    }
                }
            }
        }
    }

    if context-menu-visible: Rectangle {
        width: 100%; height: 100%; z: 150;
        TouchArea { clicked => { context-menu-visible = false; } }
        Rectangle {
            x: Math.max(8px, Math.min(context-menu-x * 1px, parent.width - self.width - 8px));
            y: Math.max(8px, Math.min((context-menu-y - 106) * 1px, parent.height - self.height - 8px));
            width: 240px; height: 196px; background: #1e2430; border-radius: 8px; border-width: 1px; border-color: #3a4560;
            VerticalLayout {
                padding: 4px; spacing: 4px;
                Rectangle {
                    height: 28px; background: item-toggle.has-hover ? #2f3a50 : #2a3448; border-radius: 4px;
                    item-toggle := TouchArea { clicked => { if (context-menu-target-paused) { start-torrent(context-menu-target-id); } else { stop-torrent(context-menu-target-id); } context-menu-visible = false; } }
                    Text { text: (context-menu-target-paused ? "▶ " + tr-menu-start : "⏸ " + tr-menu-pause); color: #c0d0e8; font-size: 13px; x: 12px; }
                }
                Rectangle {
                    height: 28px; background: item-recheck.has-hover ? #2f3a50 : #2a3448; border-radius: 4px;
                    item-recheck := TouchArea { clicked => { recheck-torrent(context-menu-target-id); context-menu-visible = false; } }
                    Text { text: "🔄 " + tr-menu-recheck; color: #c0d0e8; font-size: 13px; x: 12px; }
                }
                Rectangle {
                    height: 28px; background: item-folder.has-hover ? #2f3a50 : #2a3448; border-radius: 4px;
                    item-folder := TouchArea { clicked => { open-folder(context-menu-torrent-dir); context-menu-visible = false; } }
                    Text { text: "📁 " + tr-menu-open-folder; color: #c0d0e8; font-size: 13px; x: 12px; }
                }
                Rectangle {
                    height: 28px; background: item-location.has-hover ? #2f3a50 : #2a3448; border-radius: 4px;
                    item-location := TouchArea { clicked => { let last_path = get-last-location(); pick-context-menu-set-location(context-menu-target-id, context-menu-torrent-name, last_path != "" ? last_path : context-menu-torrent-dir); context-menu-visible = false; } }
                    Text { text: "📍 " + tr-menu-set-location; color: #c0d0e8; font-size: 13px; x: 12px; }
                }
                Rectangle {
                    height: 28px; background: item-remove.has-hover ? #4a2020 : #2a3448; border-radius: 4px;
                    item-remove := TouchArea { clicked => { pending-id = context-menu-target-id; pending-torrent-name = context-menu-torrent-name; dialog-message = tr-dlg-remove-title + "\n" + tr-dlg-remove-subtitle; pending-is-delete = true; pending-delete-files = false; dialog-visible = true; context-menu-visible = false; } }
                    Text { text: "✕ " + tr-menu-remove; color: #f0b0b0; font-size: 13px; x: 12px; }
                }
            }
        }
    }

    SetLocationDialog {
        width: 100%; height: 100%; visible-dialog: set-location-dialog-visible; torrent-name: set-location-torrent-name; path <=> set-location-path; do-move <=> set-location-do-move;
        pick-folder => { set-location-xdg-dialog(set-location-torrent-id, set-location-torrent-name, set-location-path, set-location-do-move); set-location-dialog-visible = false; }
        confirmed(p, mv) => { set-location-dialog-visible = false; set-location-cmd(set-location-torrent-id, p, mv); }
        cancelled => { set-location-dialog-visible = false; }
    }

    ConfirmDialog {
        width: 100%; height: 100%; message: dialog-message; torrent-name: pending-torrent-name; show-warning: pending-is-delete && pending-delete-files; visible-dialog: dialog-visible;
        tr-cancel: tr-dlg-cancel; tr-confirm: tr-dlg-confirm; tr-delete-warning: tr-dlg-delete-warning; tr-irreversible: tr-dlg-irreversible;
        confirmed => { dialog-visible = false; if (pending-is-delete) { remove-torrent(pending-id, pending-delete-files); } else if (pending-id == -1) { start-all(); } else { stop-all(); } }
        cancelled => { dialog-visible = false; }
    }

    CloseDialog {
        width: 100%; height: 100%; visible-dialog: close-dialog-visible;
        minimize-to-tray => { close-dialog-visible = false; do-minimize-tray(); }
        quit-app => { close-dialog-visible = false; do-quit(); }
        cancelled => { close-dialog-visible = false; }
    }

    AddTorrentDialog {
        width: 100%; height: 100%; visible-dialog: add-dialog-visible;
        submitted-url(url) => { add-dialog-visible = false; add-torrent-url(url); }
        pick-file => { add-dialog-visible = false; pick-torrent-file(); }
        cancelled => { add-dialog-visible = false; }
    }

    CreateTorrentDialog {
        width: 100%; height: 100%; visible-dialog: create-dialog-visible; path-text <=> pending-create-path;
        submitted(path, trackers) => { create-dialog-visible = false; create-torrent(path, trackers); }
        pick-path => { pick-create-path(); }
        cancelled => { create-dialog-visible = false; pending-create-path = ""; }
    }

    MagnetDialog {
        width: 100%; height: 100%; visible-dialog: magnet-dialog-visible; magnet-uri <=> magnet-uri;
        submitted(uri) => { magnet-dialog-visible = false; magnet-submitted(uri); }
        cancelled => { magnet-dialog-visible = false; magnet-uri = ""; }
    }

    if is-switching-host: Rectangle {
        width: 100%; height: 100%; z: 500;
        background: #09101acc;
        TouchArea { } // Block clicks during switch
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px; height: 180px;
            background: #111a28f2;
            border-radius: 12px;
            border-width: 1px;
            border-color: #263a56;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                alignment: center;
                Rectangle {
                    width: 48px; height: 48px;
                    border-radius: 24px;
                    background: #172437;
                    border-width: 1px;
                    border-color: #38bdf840;
                    x: (parent.width - self.width) / 2;
                    Text {
                        text: "🔄";
                        font-size: 20px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: selected-language == "ru" ? "Подключение к хосту…" : "Connecting to host…";
                        color: #e4e7f2;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: switching-host-name;
                        color: #60a5fa;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
                Rectangle {
                    width: 100%; height: 4px;
                    background: #131d2c;
                    border-radius: 2px;
                    Rectangle {
                        width: 40%; height: 100%;
                        background: #38bdf8;
                        border-radius: 2px;
                        x: (parent.width - self.width) / 2;
                    }
                }
                Text {
                    text: selected-language == "ru" ? "Синхронизация состояния сессии и списка раздач…" : "Synchronizing session state and torrent listings…";
                    color: #7b90ab;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    SettingsDialog {
        width: 100%; height: 100%; visible-dialog: settings-dialog-visible; selected-language <=> selected-language; settings-tab <=> settings-tab;
        cfg-speed-up-enabled <=> cfg-speed-up-enabled; cfg-speed-up-kbs <=> cfg-speed-up-kbs; cfg-speed-down-enabled <=> cfg-speed-down-enabled; cfg-speed-down-kbs <=> cfg-speed-down-kbs;
        cfg-alt-speed-enabled <=> cfg-alt-speed-enabled; cfg-alt-speed-up-kbs <=> cfg-alt-speed-up-kbs; cfg-alt-speed-down-kbs <=> cfg-alt-speed-down-kbs; cfg-alt-speed-schedule <=> cfg-alt-speed-schedule; cfg-alt-speed-time-begin <=> cfg-alt-speed-time-begin; cfg-alt-speed-time-end <=> cfg-alt-speed-time-end;
        cfg-speed-day-mon <=> cfg-speed-day-mon; cfg-speed-day-tue <=> cfg-speed-day-tue; cfg-speed-day-wed <=> cfg-speed-day-wed; cfg-speed-day-thu <=> cfg-speed-day-thu; cfg-speed-day-fri <=> cfg-speed-day-fri; cfg-speed-day-sat <=> cfg-speed-day-sat; cfg-speed-day-sun <=> cfg-speed-day-sun;
        cfg-dl-watch-dir-enabled <=> cfg-dl-watch-dir-enabled; cfg-dl-watch-dir <=> cfg-dl-watch-dir; cfg-dl-show-dialog <=> cfg-dl-show-dialog; cfg-dl-start-added <=> cfg-dl-start-added; cfg-dl-trash-torrent <=> cfg-dl-trash-torrent; cfg-dl-dir <=> cfg-dl-dir; cfg-dl-queue-max <=> cfg-dl-queue-max; cfg-dl-seed-ratio-limit-min <=> cfg-dl-seed-ratio-limit-min; cfg-dl-part-ext <=> cfg-dl-part-ext; cfg-dl-incomplete-dir-enabled <=> cfg-dl-incomplete-dir-enabled; cfg-dl-incomplete-dir <=> cfg-dl-incomplete-dir; cfg-dl-done-script-enabled <=> cfg-dl-done-script-enabled; cfg-dl-done-script <=> cfg-dl-done-script;
        cfg-seed-ratio-enabled <=> cfg-seed-ratio-enabled; cfg-seed-ratio <=> cfg-seed-ratio; cfg-seed-idle-enabled <=> cfg-seed-idle-enabled; cfg-seed-idle-min <=> cfg-seed-idle-min; cfg-seed-done-script-enabled <=> cfg-seed-done-script-enabled; cfg-seed-done-script <=> cfg-seed-done-script;
        cfg-net-port <=> cfg-net-port; cfg-net-random-port <=> cfg-net-random-port; cfg-net-port-forward <=> cfg-net-port-forward; cfg-net-max-peers-torrent <=> cfg-net-max-peers-torrent; cfg-net-max-peers-total <=> cfg-net-max-peers-total; cfg-net-utp <=> cfg-net-utp; cfg-net-pex <=> cfg-net-pex; cfg-net-dht <=> cfg-net-dht; cfg-net-lpd <=> cfg-net-lpd; cfg-net-default-trackers <=> cfg-net-default-trackers;
        cfg-priv-encryption <=> cfg-priv-encryption; cfg-priv-blocklist-enabled <=> cfg-priv-blocklist-enabled; cfg-priv-blocklist-url <=> cfg-priv-blocklist-url; cfg-priv-blocklist-auto-update <=> cfg-priv-blocklist-auto-update; cfg-priv-blocklist-entries <=> cfg-priv-blocklist-entries;
        cfg-remote-enabled <=> cfg-remote-enabled; cfg-remote-port <=> cfg-remote-port; cfg-remote-auth <=> cfg-remote-auth; cfg-remote-username <=> cfg-remote-username; cfg-remote-password <=> cfg-remote-password; cfg-remote-whitelist-enabled <=> cfg-remote-whitelist-enabled; cfg-remote-whitelist <=> cfg-remote-whitelist;
        cfg-autostart <=> cfg-autostart; cfg-suspend <=> cfg-suspend; cfg-start-minimized <=> cfg-start-minimized; cfg-delete-torrent <=> cfg-delete-torrent; cfg-refresh-interval <=> cfg-refresh-interval; cfg-on-close <=> cfg-on-close; cfg-notify-add <=> cfg-notify-add; cfg-notify-complete <=> cfg-notify-complete; cfg-notify-sound <=> cfg-notify-sound; cfg-theme <=> cfg-theme;
        cfg-tb-add <=> cfg-tb-add; cfg-tb-magnet <=> cfg-tb-magnet; cfg-tb-create <=> cfg-tb-create; cfg-tb-rehash <=> cfg-tb-rehash; cfg-tb-start-sel <=> cfg-tb-start-sel; cfg-tb-pause-sel <=> cfg-tb-pause-sel; cfg-tb-start-all <=> cfg-tb-start-all; cfg-tb-pause-all <=> cfg-tb-pause-all;
        cfg-lp-status <=> cfg-lp-status; cfg-lp-disks <=> cfg-lp-disks; cfg-lp-trackers <=> cfg-lp-trackers; cfg-lp-webtorrents <=> cfg-lp-webtorrents; cfg-lp-tags <=> cfg-lp-tags; cfg-lp-created <=> cfg-lp-created;
        language-changed(lang) => { language-changed(lang); }
        saved => { saved(); settings-dialog-visible = false; }
        cancelled => { settings-dialog-visible = false; }
        pick-dl-script-path => { pick-dl-script-path(); }
        pick-seed-script-path => { pick-seed-script-path(); }
