    in-out property <int>     settings-tab: 0;
    in-out property <bool>   cfg-speed-up-enabled: false;
    in-out property <int>     cfg-speed-up-kbs: 0;
    in-out property <bool>   cfg-speed-down-enabled: false;
    in-out property <int>     cfg-speed-down-kbs: 0;
