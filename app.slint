// Реальный диалог завершения: stopped-announce трекерам + ожидание смерти демона.
component CloseAnimDialog inherits Rectangle {
    in property <bool> visible-dialog;
    in property <int> trackers-count;
    in property <int> phase; // 0 = отправка, 1 = демон остановлен
    in property <string> selected-language: "ru";
    in property <string> s-left: "";
    in property <[string]> ticker;
    callback force-quit();

    property <float> spin: 0;
    property <float> bar-t: 0;
    property <int> ticker-idx: 0;

    visible: visible-dialog; z: 200;
    background: #000000aa;

    Timer {
        interval: 33ms;
        running: visible-dialog;
        triggered() => {
            spin = Math.mod(spin + 0.09, 1.0);
            bar-t = Math.mod(bar-t + 0.008, 1.0);
        }
    }
    Timer {
        interval: 550ms;
        running: visible-dialog && ticker.length > 0;
        triggered() => { ticker-idx = Math.mod(ticker-idx + 1, ticker.length); }
    }

    TouchArea { width: 100%; height: 100%; }

    Rectangle {
        width: 460px; height: 330px;
        background: #1c1d29; border-radius: 8px;
        border-width: 1px; border-color: #2c2d42;
        drop-shadow-blur: 16px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;

        VerticalLayout {
            VerticalLayout {
                padding: 22px; padding-bottom: 14px; spacing: 14px;
                HorizontalLayout {
                    spacing: 16px; alignment: start;
                    Rectangle {
                        width: 48px; height: 48px; border-radius: 24px;
                        border-width: 2px; border-color: #3b3054;
                        background: #1e1b30;
                        Text {
                            text: "↻"; font-size: 22px; color: #a47ef6;
                            horizontal-alignment: center; vertical-alignment: center;
                            rotation-angle: visible-dialog ? spin * 360deg : 0deg;
                            rotation-origin-x: self.width / 2;
                            rotation-origin-y: self.height / 2;
                        }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 5px;
                        Text {
                            text: phase == 1 ? Tr.ca_done : Tr.ca_shutting;
                            color: #ffffff; font-size: 15px; font-weight: 700;
                        }
                        Text { text: Tr.ca_sending; color: #5e637a; font-size: 11px; }
                    }
                }

                Rectangle {
                    width: 100%; height: 4px; border-radius: 2px; background: #2a2b38;
                    Rectangle {
                        width: parent.width * 0.4; height: parent.height; border-radius: 2px;
                        background: phase == 1 ? #2a9a50 : #3f72f6;
                        x: Math.abs(Math.sin(bar-t * 180deg)) * (parent.width - self.width);
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: phase == 1 ? Tr.ca_done_closing
                            : (trackers-count > 0
                                ? (Tr.ca_notifying + trackers-count + Tr.ca_units)
                                : Tr.port_unknown);
                        color: phase == 1 ? #2a9a50 : #b8c2d8; font-size: 12px;
                    }
                    Text { text: Tr.ca_left + s-left; color: #a2add0; font-size: 11px; }
                }

                Rectangle {
                    width: 100%; height: 30px; border-radius: 5px;
                    background: #101116; border-width: 1px; border-color: #20212f;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        Text {
                            width: parent.width;
                            text: ticker.length > 0 ? ticker[ticker-idx] : "—";
                            color: #7aa2f7; font-size: 11px; vertical-alignment: center; overflow: elide;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #2a2b38; }

            Rectangle {
                background: #181926; height: 52px;
                border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
                HorizontalLayout {
                    padding: 10px; padding-left: 24px; padding-right: 24px; spacing: 14px; alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 130px; height: 30px; border-radius: 4px;
                        background: ta-exit.has-hover ? #f06a60 : #e15f55;
                        Text { text: Tr.exit_now; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        ta-exit := TouchArea { clicked => { force-quit(); } }
                    }
                }
            }
        }
    }
}

// Числовое поле: клик → фокус → ввод цифр; Enter нормализует; кнопки −/+ меняют value извне
component NumField inherits Rectangle {
    in property <int> value;
    callback value-changed(int);
    in property <int> min-val: 0;
    in property <int> max-val: 9999;
    in property <bool> editable: true;
    in property <length> field-width: 70px;
    in property <length> field-height: 32px;
    in property <bool> plain: false;
    property <string> txt;
    init => { txt = value + ""; }
    changed value => {
        if (!ti.has-focus) { txt = value + ""; }
    }
    width: field-width; height: field-height;
    border-radius: 4px;
    background: plain ? transparent : #171825;
    border-width: 1px;
    border-color: ti.has-focus ? #3f72f6 : (plain ? #343858 : #2c2d42);
    opacity: editable ? 1.0 : 0.45;
    HorizontalLayout {
        padding-left: 10px; padding-right: 8px;
        ti := TextInput {
            font-size: 13px;
            color: editable ? #e2e8f0 : #4e556e;
            vertical-alignment: center;
            enabled: editable;
            input-type: number;
            text <=> txt;
            edited => {
                if (self.text.is-empty) { return; }
                root.value-changed(Math.clamp(Math.round(self.text.to-float()), min-val, max-val));
            }
            accepted => { txt = value + ""; }
        }
    }
    TouchArea {
        clicked => { if (editable) { ti.focus(); ti.select-all(); } }
    }
}


component NumFieldF inherits Rectangle {
    in property <int> value;        // сотые доли: 244 = 2.44
    callback value-changed(int);
    in property <int> min-val: 0;
    in property <int> max-val: 10000;
    in property <bool> editable: true;
    in property <length> field-width: 56px;
    in property <length> field-height: 26px;
    property <string> txt;
    init => { txt = Math.floor(value / 100) + "." + Math.mod(Math.floor(value / 10), 10) + Math.mod(value, 10); }
    changed value => {
        if (!ti.has-focus) {
            txt = Math.floor(value / 100) + "." + Math.mod(Math.floor(value / 10), 10) + Math.mod(value, 10);
        }
    }
    width: field-width; height: field-height;
    border-radius: 4px;
    background: #171825;
    border-width: 1px;
    border-color: ti.has-focus ? #3f72f6 : #2c2d42;
    opacity: editable ? 1.0 : 0.45;
    ti := TextInput {
        x: 8px; width: parent.width - 12px; height: parent.height;
        font-size: 12px; color: editable ? #e2e8f0 : #4e556e;
        vertical-alignment: center; single-line: true;
        enabled: editable; input-type: decimal;
        text <=> txt;
        edited => {
            if (self.text.is-empty) { return; }
            root.value-changed(Math.clamp(Math.round(self.text.to-float() * 100), min-val, max-val));
        }
        accepted => {
            txt = Math.floor(value / 100) + "." + Math.mod(Math.floor(value / 10), 10) + Math.mod(value, 10);
        }
    }
    TouchArea {
        clicked => { if (editable) { ti.focus(); ti.select-all(); } }
    }
}

// Поле времени HH:MM (внутри хранятся минуты): ввод 3-4 цифр как ЧЧММ
component TimeField inherits Rectangle {
    in-out property <int> minutes;   // 0..1439
    callback touched-cb();
    in property <bool> editable: true;
    property <int> hh: 0;
    property <int> mm: 0;
    property <string> hh-txt;
    property <string> mm-txt;
    function sync-from-minutes() {
        hh = Math.min(23, Math.floor(minutes / 60));
        mm = Math.min(59, Math.mod(minutes, 60));
        hh-txt = (hh < 10 ? "0" : "") + hh;
        mm-txt = (mm < 10 ? "0" : "") + mm;
    }
    function apply() {
        minutes = Math.clamp(hh, 0, 23) * 60 + Math.clamp(mm, 0, 59);
        touched-cb();
    }
    init => { sync-from-minutes(); }
    changed minutes => {
        if (!hhi.has-focus && !mmi.has-focus) { sync-from-minutes(); }
        touched-cb();
    }
    width: 74px; height: 28px;
    border-radius: 4px; background: transparent; border-width: 1px; border-color: hhi.has-focus || mmi.has-focus ? #3f72f6 : #343858;
    opacity: editable ? 1.0 : 0.5;
    hhi := TextInput {
        x: 0; width: 28px; height: parent.height;
        font-size: 13px; color: #dce4f5;
        horizontal-alignment: center; vertical-alignment: center;
        enabled: editable; input-type: number;
        text <=> hh-txt;
        edited => {
            if (self.text.is-empty) { return; }
            hh = Math.clamp(Math.round(self.text.to-float()), 0, 23);
            apply();
        }
        accepted => { sync-from-minutes(); }
    }
    Text { text: ":"; color: #7a8296; font-size: 13px; x: 28px; width: 18px; height: parent.height; horizontal-alignment: center; vertical-alignment: center; }
    mmi := TextInput {
        x: 46px; width: 28px; height: parent.height;
        font-size: 13px; color: #dce4f5;
        horizontal-alignment: center; vertical-alignment: center;
        enabled: editable; input-type: number;
        text <=> mm-txt;
        edited => {
            if (self.text.is-empty) { return; }
            mm = Math.clamp(Math.round(self.text.to-float()), 0, 59);
            apply();
        }
        accepted => { sync-from-minutes(); }
    }
    TouchArea {
        x: 0; width: 28px; height: parent.height;
        clicked => { if (editable) { hhi.focus(); hhi.select-all(); } }
    }
    TouchArea {
        x: 46px; width: 28px; height: parent.height;
        clicked => { if (editable) { mmi.focus(); mmi.select-all(); } }
    }
}

